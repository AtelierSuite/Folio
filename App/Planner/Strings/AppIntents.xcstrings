    "DeleteEventIntent.Description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löscht ein Ereignis nach einer Bestätigung. Bei einem wiederholten Ereignis wird nur dieser Termin gelöscht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deletes an event after asking you to confirm. For a repeating event, only this occurrence is deleted."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprime un évènement après confirmation. Pour un évènement récurrent, seule cette occurrence est supprimée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina un evento dopo la conferma. Per un evento ripetuto viene eliminata solo questa occorrenza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "確認の後にイベントを削除します。繰り返しイベントの場合はこの回だけが削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "확인 후 이벤트를 삭제합니다. 반복 이벤트는 이번 일정만 삭제됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwijdert een activiteit na bevestiging. Bij een herhaalde activiteit wordt alleen deze keer verwijderd."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xoá sự kiện sau khi bạn xác nhận. Với sự kiện lặp lại, chỉ lần này bị xoá."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "确认后删除日程。对于重复日程，只删除这一次。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "確認後刪除行程。對於重複行程，只刪除這一次。"
          }
        }
      }
    },
