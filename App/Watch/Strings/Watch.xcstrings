          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定でFolioのカレンダーへのアクセスをオンにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정에서 Folio의 캘린더 접근을 켜십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zet de toegang van Folio tot je agenda’s aan in Instellingen."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy bật quyền truy cập lịch cho Folio trong Cài đặt."
