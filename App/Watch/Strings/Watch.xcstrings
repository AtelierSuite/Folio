    "Access.Denied" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube Folio in den Einstellungen den Zugriff auf deine Kalender."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn on Folio’s access to your calendars in Settings."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez l’accès de Folio à vos calendriers dans Réglages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
