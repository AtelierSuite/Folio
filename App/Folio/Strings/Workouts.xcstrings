          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "瑜伽"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "瑜伽"
          }
        }
      }
    },
    "Empty.Description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trainings, die von der Apple Watch, dem iPhone oder anderen Apps in der Health-App erfasst werden, erscheinen in deinem Kalender. Falls keine erscheinen, prüfe, ob Folio in der Health-App Trainings lesen darf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Workouts recorded by Apple Watch, iPhone or other apps in the Health app will appear on your calendar. If none appear, check that Folio can read Workouts in the Health app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les exercices enregistrés dans l’app Santé par l’Apple Watch, l’iPhone ou d’autres apps apparaîtront dans votre calendrier. Si aucun n’apparaît, vérifiez que Folio peut lire les exercices dans l’app Santé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli allenamenti registrati in Salute da Apple Watch, iPhone o altre app appariranno nel calendario. Se non ne compare nessuno, verifica che Folio possa leggere gli allenamenti in Salute."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch、iPhone、またはほかのアプリでヘルスケアに記録されたワークアウトがカレンダーに表示されます。表示されない場合は、ヘルスケアでFolioがワークアウトを読み出せるか確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch, iPhone 또는 다른 앱이 건강 앱에 기록한 운동이 캘린더에 표시됩니다. 표시되지 않으면 건강 앱에서 Folio가 운동을 읽을 수 있는지 확인하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trainingen die door Apple Watch, iPhone of andere apps in de Gezondheid-app worden vastgelegd, verschijnen in je agenda. Verschijnen er geen, controleer dan of Folio trainingen mag lezen in de Gezondheid-app."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các bài tập được Apple Watch, iPhone hoặc ứng dụng khác ghi lại trong ứng dụng Sức khỏe sẽ xuất hiện trên lịch. Nếu không thấy, hãy kiểm tra xem Folio có thể đọc Bài tập trong ứng dụng Sức khỏe không."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch、iPhone或其他App在“健康”中记录的体能训练会显示在日历上。如果没有显示，请检查Folio能否在“健康”中读取体能训练。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch、iPhone或其他App在「健康」中記錄的體能訓練會顯示在行事曆上。若未顯示，請檢查Folio是否能在「健康」中讀取體能訓練。"
          }
        }
      }
    },
