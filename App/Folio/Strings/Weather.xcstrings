    "Settings.LocationDenied" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Standortzugriff ist deaktiviert, daher kann Folio deinen aktuellen Standort nicht verwenden. Wähle stattdessen einen Ort oder aktiviere den Standortzugriff in den Einstellungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Location access is off, so Folio can’t use your current location. Choose a place instead, or turn on location access in Settings."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accès à la position est désactivé : Folio ne peut pas utiliser votre position actuelle. Choisissez plutôt un lieu ou activez l’accès à la position dans Réglages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accesso alla posizione è disattivato, quindi Folio non può usare la tua posizione attuale. Scegli un luogo oppure attiva l’accesso alla posizione in Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位置情報へのアクセスがオフのため、現在地を使用できません。代わりに場所を選択するか、設定で位置情報へのアクセスをオンにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "위치 접근이 꺼져 있어 Folio가 현재 위치를 사용할 수 없습니다. 대신 장소를 선택하거나 설정에서 위치 접근을 켜세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Locatietoegang staat uit, dus Folio kan je huidige locatie niet gebruiken. Kies in plaats daarvan een plaats of zet locatietoegang aan in Instellingen."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quyền truy cập vị trí đang tắt nên Folio không thể dùng vị trí hiện tại của bạn. Hãy chọn một địa điểm hoặc bật quyền truy cập vị trí trong Cài đặt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
