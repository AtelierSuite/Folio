          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các sự kiện hôm nay giữ nguyên giờ đã lên lịch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
