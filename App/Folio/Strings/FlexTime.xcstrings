    "Prompt.Message %@": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein erster Termin heute ist um %@. Möchtest du die heutigen Termine nach hinten verschieben?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your first event today is at %@. Would you like to move today’s events later?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre premier événement aujourd’hui est à %@. Voulez-vous décaler les événements d’aujourd’hui ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo primo evento di oggi è alle %@. Vuoi spostare più avanti gli eventi di oggi?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日の最初の予定は%@です。今日の予定を遅らせますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 첫 일정은 %@입니다. 오늘 일정을 뒤로 미룰까요?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je eerste afspraak vandaag is om %@. Wil je de afspraken van vandaag later zetten?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sự kiện đầu tiên hôm nay của bạn bắt đầu lúc %@. Bạn có muốn dời các sự kiện hôm nay muộn hơn không?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天的第一个日程在 %@。要把今天的日程往后移吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "今天的第一個行程在 %@。要把今天的行程往後移嗎？"
          }
        }
      }
    },
    "Prompt.Message.Active": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die heutigen Termine sind nach hinten verschoben. Möchtest du ändern, wann sie beginnen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today’s events are moved later. Would you like to change when they start?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les événements d’aujourd’hui sont décalés. Voulez-vous modifier leur heure de début ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli eventi di oggi sono spostati più avanti. Vuoi cambiare l’ora di inizio?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日の予定を遅らせています。開始時刻を変更しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 일정이 뒤로 미뤄져 있습니다. 시작 시간을 변경할까요?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De afspraken van vandaag zijn later gezet. Wil je wijzigen wanneer ze beginnen?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các sự kiện hôm nay đã được dời muộn hơn. Bạn có muốn đổi giờ bắt đầu không?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天的日程已往后移。要更改开始时间吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "今天的行程已往後移。要更改開始時間嗎？"
          }
        }
      }
    },
    "Prompt.Message.FirstOpen %@ %@": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast Folio heute zuerst um %1$@ geöffnet, und dein erster Termin ist um %2$@. Möchtest du die heutigen Termine nach hinten verschieben?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You first opened Folio at %1$@, and your first event today is at %2$@. Would you like to move today’s events later?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez ouvert Folio pour la première fois à %1$@, et votre premier événement aujourd’hui est à %2$@. Voulez-vous décaler les événements d’aujourd’hui ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai aperto Folio per la prima volta alle %1$@ e il tuo primo evento di oggi è alle %2$@. Vuoi spostare più avanti gli eventi di oggi?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日は%1$@に初めてFolioを開きました。最初の予定は%2$@です。今日の予定を遅らせますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 %1$@에 Folio를 처음 열었고, 첫 일정은 %2$@입니다. 오늘 일정을 뒤로 미룰까요?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je opende Folio vandaag voor het eerst om %1$@ en je eerste afspraak is om %2$@. Wil je de afspraken van vandaag later zetten?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn mở Folio lần đầu lúc %1$@, và sự kiện đầu tiên hôm nay bắt đầu lúc %2$@. Bạn có muốn dời các sự kiện hôm nay muộn hơn không?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你今天在 %1$@ 首次打开 Folio，而第一个日程在 %2$@。要把今天的日程往后移吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你今天在 %1$@ 首次打開 Folio，而第一個行程在 %2$@。要把今天的行程往後移嗎？"
          }
        }
      }
    },
    "Prompt.Message.Sleep %@ %@": {
