    "Prompt.NoDelay": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die heutigen Termine bleiben zur geplanten Zeit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today’s events stay at their scheduled times."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les événements d’aujourd’hui restent à l’heure prévue."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli eventi di oggi restano all’orario previsto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日の予定は予定どおりの時刻のままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 일정은 예정된 시간 그대로입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
