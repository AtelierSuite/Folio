    "Prompt.NoEvents.Description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Flexzeit verschiebt die heutigen Termine mit Uhrzeit, und heute gibt es keine."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Flex Time delays today’s timed events, and there are none today."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le temps flexible décale les événements d’aujourd’hui ayant une heure, et il n’y en a aucun aujourd’hui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’orario flessibile posticipa gli eventi di oggi con un orario, e oggi non ce ne sono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フレックスタイムは今日の時刻指定の予定を遅らせますが、今日は該当する予定がありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "플렉스 타임은 오늘 시간이 지정된 일정을 늦추지만, 오늘은 해당 일정이 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Flextijd stelt de afspraken van vandaag met een tijd uit, en vandaag zijn er geen."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giờ linh hoạt lùi các sự kiện có giờ của hôm nay, và hôm nay không có sự kiện nào."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "弹性时间会推迟今天有具体时间的日程，但今天没有这样的日程。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "彈性時間會延後今天有具體時間的行程，但今天沒有這樣的行程。"
          }
        }
      }
    },
    "Prompt.NoEvents.Title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Termine zum Verschieben"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Events to Delay"
          }
        },
        "fr": {
