    "Settings.FirstOpen.Footer": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Zeitpunkt, zu dem du Folio jeden Tag zum ersten Mal öffnest, gilt als Aufwachzeit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The time you first open Folio each day counts as your wake-up time."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’heure à laquelle vous ouvrez Folio pour la première fois chaque jour compte comme heure de réveil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’ora in cui apri Folio per la prima volta ogni giorno vale come ora del risveglio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎日初めてFolioを開いた時刻を起床時刻とみなします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매일 Folio를 처음 연 시간이 기상 시간으로 간주됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het moment waarop je Folio elke dag voor het eerst opent, telt als je wektijd."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thời điểm bạn mở Folio lần đầu mỗi ngày được tính là giờ thức dậy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每天首次打开 Folio 的时间将视为起床时间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每天首次打開 Folio 的時間將視為起床時間。"
          }
        }
      }
    },
