    "Settings.Sleep.Footer": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio liest deine Aufwachzeit aus der Health-App. Ohne Schlafdaten gilt der Zeitpunkt, zu dem du Folio an dem Tag zum ersten Mal öffnest, als Aufwachzeit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio reads when you woke up from the Health app. Without sleep data, the time you first open Folio that day counts as your wake-up time."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio lit votre heure de réveil dans l’app Santé. Sans données de sommeil, l’heure à laquelle vous ouvrez Folio pour la première fois ce jour-là compte comme heure de réveil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio legge l’ora del risveglio dall’app Salute. Senza dati sul sonno, l’ora in cui apri Folio per la prima volta quel giorno vale come ora del risveglio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Folioはヘルスケアから起床時刻を読み取ります。睡眠データがない場合は、その日に初めてFolioを開いた時刻を起床時刻とみなします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio는 건강 앱에서 기상 시간을 읽습니다. 수면 데이터가 없으면 그날 Folio를 처음 연 시간이 기상 시간으로 간주됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio leest in de Gezondheid-app wanneer je wakker werd. Zonder slaapgegevens telt het moment waarop je Folio die dag voor het eerst opent als je wektijd."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio đọc giờ bạn thức dậy từ ứng dụng Sức khỏe. Nếu không có dữ liệu giấc ngủ, thời điểm bạn mở Folio lần đầu trong ngày được tính là giờ thức dậy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio 会从“健康”中读取你的起床时间。没有睡眠数据时，当天首次打开 Folio 的时间将视为起床时间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio 會從「健康」中讀取你的起床時間。沒有睡眠資料時，當天首次打開 Folio 的時間將視為起床時間。"
          }
        }
      }
    },
