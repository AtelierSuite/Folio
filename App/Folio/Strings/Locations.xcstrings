    "Settings.Footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New events start at the default location. Saved locations, like home or work, appear first when you choose a location."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新規イベントにはデフォルトの場所が設定されます。自宅や職場など保存した場所は、場所を選ぶときに最初に表示されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新日程会以默认位置开始。已存储的位置（如家庭或工作地点）会在选择位置时最先显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新行程會以預設位置開始。已儲存的位置（例如住家或公司）會在選擇位置時最先顯示。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새로운 이벤트에 기본 위치가 설정됩니다. 집이나 직장처럼 저장한 위치는 위치를 선택할 때 맨 위에 표시됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les nouveaux événements commencent au lieu par défaut. Les lieux enregistrés, comme le domicile ou le travail, apparaissent en premier lorsque vous choisissez un lieu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neue Ereignisse beginnen mit dem Standardort. Gesicherte Orte wie Zuhause oder Arbeit werden bei der Ortsauswahl zuerst angezeigt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I nuovi eventi iniziano con il luogo predefinito. I luoghi salvati, come casa o lavoro, appaiono per primi quando scegli un luogo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nieuwe activiteiten beginnen met de standaardlocatie. Bewaarde locaties, zoals thuis of werk, staan bovenaan wanneer je een locatie kiest."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sự kiện mới sẽ dùng địa điểm mặc định. Các địa điểm đã lưu, như nhà hoặc nơi làm việc, sẽ hiện đầu tiên khi bạn chọn địa điểm."
          }
        }
      }
    },
