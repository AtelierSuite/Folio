    "Settings.WhenInUse": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stelle den Standortzugriff auf „Immer“, damit Aufbruchshinweise auch bei geschlossenem Folio aktuell bleiben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set location access to Always so time to leave alerts stay up to date while Folio is closed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réglez l'accès à la position sur Toujours pour que les alertes de départ restent à jour quand Folio est fermé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta l'accesso alla posizione su Sempre affinché gli avvisi di partenza restino aggiornati anche quando Folio è chiuso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Folioを閉じている間も出発時刻の通知を最新に保つには、位置情報へのアクセスを「常に」に設定してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio가 닫혀 있을 때도 출발 시간 알림이 최신 상태로 유지되도록 위치 접근을 '항상'으로 설정하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet locatietoegang op Altijd zodat vertrekmeldingen actueel blijven terwijl Folio gesloten is."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt quyền truy cập vị trí thành Luôn luôn để cảnh báo giờ khởi hành luôn được cập nhật khi Folio đóng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将位置访问设为“始终”，以便在 Folio 关闭时出发时间提醒也能保持最新。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將位置取用設為「永遠」，讓 Folio 關閉時出發時間提醒也能保持最新。"
          }
        }
      }
    },
