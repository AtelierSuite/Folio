{
  "sourceLanguage": "en",
  "strings": {
    "Editor.Footer": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erhalte einen Hinweis, wenn es Zeit ist aufzubrechen – je nach Reisezeit von deinem Standort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get an alert when it's time to leave, based on the travel time from where you are."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recevez une alerte quand il est temps de partir, selon le temps de trajet depuis votre position."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricevi un avviso quando è ora di partire, in base al tempo di percorrenza da dove ti trovi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在地からの所要時間をもとに、出発する時刻になると通知します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 위치에서의 이동 시간을 기준으로 출발할 시간이 되면 알려 줍니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Krijg een melding wanneer het tijd is om te vertrekken, op basis van de reistijd vanaf waar je bent."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhận cảnh báo khi đến lúc khởi hành, dựa trên thời gian di chuyển từ vị trí của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据从你所在位置出发的路程时间，在该出发时提醒你。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "根據從你所在位置出發的交通時間，在該出發時提醒你。"
          }
        }
      }
    },
    "Editor.NoLocation": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge einen Ort hinzu, um einen Hinweis zu erhalten, wenn es Zeit ist aufzubrechen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a location to get an alert when it's time to leave."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez un lieu pour recevoir une alerte quand il est temps de partir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi un luogo per ricevere un avviso quando è ora di partire."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "出発時刻の通知を受け取るには、場所を追加してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "출발 시간 알림을 받으려면 위치를 추가하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg een locatie toe om een melding te krijgen wanneer het tijd is om te vertrekken."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm vị trí để nhận cảnh báo khi đến lúc khởi hành."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加位置以在该出发时收到提醒。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "加入位置以在該出發時收到提醒。"
          }
        }
      }
    },
    "Editor.Toggle": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufbruchshinweis"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Time to Leave"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alerte de départ"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avviso di partenza"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "出発時刻を通知"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "출발 시간 알림"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vertrekmelding"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Báo giờ khởi hành"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "出发时间提醒"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "出發時間提醒"
          }
        }
      }
    },
    "Editor.TurnedOff": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere Mitteilungen und Aufbruchshinweise in den Einstellungen, um diesen Hinweis zu erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on Notifications and Time to Leave Alerts in Settings to get this alert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez Notifications et Alertes de départ dans Réglages pour recevoir cette alerte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva Notifiche e Avvisi di partenza in Impostazioni per ricevere questo avviso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この通知を受け取るには、設定で「通知」と「出発時刻の通知」をオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 알림을 받으려면 설정에서 알림과 출발 시간 알림을 켜세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet Meldingen en Vertrekmeldingen aan in Instellingen om deze melding te krijgen."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật Thông báo và Cảnh báo giờ khởi hành trong Cài đặt để nhận cảnh báo này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“设置”中打开“通知”和“出发时间提醒”以收到此提醒。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在「設定」中開啟「通知」和「出發時間提醒」以收到此提醒。"
          }
        }
      }
    },
    "Settings.Denied": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio kann deinen Standort nicht verwenden. Erlaube den Standortzugriff in den Einstellungen, um Aufbruchshinweise zu erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio can't use your location. Allow location access in Settings to get time to leave alerts."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio ne peut pas utiliser votre position. Autorisez l'accès à la position dans Réglages pour recevoir les alertes de départ."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio non può usare la tua posizione. Consenti l'accesso alla posizione in Impostazioni per ricevere gli avvisi di partenza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Folioは位置情報を使用できません。出発時刻の通知を受け取るには、設定で位置情報へのアクセスを許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio에서 위치를 사용할 수 없습니다. 출발 시간 알림을 받으려면 설정에서 위치 접근을 허용하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio kan je locatie niet gebruiken. Sta locatietoegang toe in Instellingen om vertrekmeldingen te krijgen."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio không thể sử dụng vị trí của bạn. Cho phép truy cập vị trí trong Cài đặt để nhận cảnh báo giờ khởi hành."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio 无法使用你的位置。请在“设置”中允许访问位置以获取出发时间提醒。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio 無法使用你的位置。請在「設定」中允許取用位置以取得出發時間提醒。"
          }
        }
      }
    },
    "Settings.Footer": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erhalte einen Hinweis, wenn es Zeit ist, zu einem Termin aufzubrechen – je nach deinem Standort und der aktuellen Reisezeit. Aktiviere ihn für jeden Termin im Termineditor."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get an alert when it's time to leave for an event, based on where you are and current travel times. Turn it on for each event in the event editor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recevez une alerte quand il est temps de partir pour un évènement, selon votre position et le temps de trajet actuel. Activez-la pour chaque évènement dans l'éditeur d'évènement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricevi un avviso quando è ora di partire per un evento, in base a dove ti trovi e ai tempi di percorrenza attuali. Attivalo per ogni evento nell'editor degli eventi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在地と現在の所要時間をもとに、予定に向けて出発する時刻になると通知します。予定ごとにイベントエディタでオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 위치와 현재 이동 시간을 기준으로 일정에 출발할 시간이 되면 알려 줍니다. 이벤트 편집기에서 일정마다 켜세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Krijg een melding wanneer het tijd is om naar een afspraak te vertrekken, op basis van waar je bent en de huidige reistijd. Zet het per afspraak aan in de afspraakeditor."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhận cảnh báo khi đến lúc khởi hành đến một sự kiện, dựa trên vị trí của bạn và thời gian di chuyển hiện tại. Bật cho từng sự kiện trong trình chỉnh sửa sự kiện."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据你所在的位置和当前路程时间，在该出发前往日程时提醒你。请在日程编辑器中为每个日程单独打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "根據你所在的位置和目前的交通時間，在該出發前往行程時提醒你。請在行程編輯器中為每個行程個別開啟。"
          }
        }
      }
    },
