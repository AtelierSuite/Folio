    "Error.Message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe, ob Folio auf „Erinnerungen“ zugreifen darf, und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check that Folio can access Reminders and try again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez que Folio peut accéder à Rappels, puis réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica che Folio possa accedere a Promemoria e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Folioがリマインダーにアクセスできることを確認して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio가 미리 알림에 접근할 수 있는지 확인한 후 다시 시도하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Controleer of Folio toegang heeft tot Herinneringen en probeer het opnieuw."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy kiểm tra Folio có thể truy cập Lời nhắc rồi thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请检查 Folio 是否可以访问“提醒事项”，然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請檢查 Folio 是否可以取用「提醒事項」，然後再試一次。"
          }
        }
      }
    },
