    "Note.Unavailable": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unteraufgaben, Abschnitte, Tags, Markierungen und Bilder aus „Erinnerungen“ sind in Folio nicht verfügbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Subtasks, sections, tags, flags and images from Reminders aren’t available in Folio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sous-tâches, sections, tags, drapeaux et images de Rappels ne sont pas disponibles dans Folio."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sottoattività, sezioni, tag, contrassegni e immagini di Promemoria non sono disponibili in Folio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リマインダーのサブタスク、セクション、タグ、フラグ、イメージはFolioでは使用できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio에서는 미리 알림의 하위 작업, 섹션, 태그, 깃발 및 이미지를 사용할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Subtaken, secties, tags, vlaggen en afbeeldingen uit Herinneringen zijn niet beschikbaar in Folio."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tác vụ phụ, mục, thẻ, cờ và hình ảnh từ Lời nhắc không có sẵn trong Folio."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio 中无法使用“提醒事项”的子任务、分组、标签、旗标和图像。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio 中無法使用「提醒事項」的子任務、區段、標籤、旗標和影像。"
          }
        }
      }
    },
