    "Alerts.NeedsDueTime": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege eine Fälligkeitszeit fest, um Hinweise relativ dazu hinzuzufügen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set a due time to add alerts relative to it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Définissez une heure d’échéance pour ajouter des alertes relatives à celle-ci."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta un’ora di scadenza per aggiungere avvisi relativi a essa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "期限の時刻を設定すると、その時刻を基準にした通知を追加できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마감 시간을 설정하면 해당 시간을 기준으로 알림을 추가할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stel een vervaltijd in om meldingen ten opzichte daarvan toe te voegen."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt giờ đến hạn để thêm cảnh báo theo giờ đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设定截止时间后即可添加相对于该时间的提醒。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定截止時間後即可加入相對於該時間的提醒。"
          }
        }
      }
    },
    "Error.Delete": {
