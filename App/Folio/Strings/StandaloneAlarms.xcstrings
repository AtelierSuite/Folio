    "Composer.Failed.Message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das System hat diesen Wecker nicht angenommen. Lösche einen Wecker, den du nicht mehr brauchst, und versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The system didn’t accept this alarm. Delete an alarm you no longer need and try again."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le système n’a pas accepté cette alarme. Supprimez une alarme dont vous n’avez plus besoin, puis réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il sistema non ha accettato questa sveglia. Elimina una sveglia che non ti serve più e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "システムがこのアラームを受け付けませんでした。不要なアラームを削除してから、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시스템에서 이 알람을 허용하지 않았습니다. 더 이상 필요 없는 알람을 삭제한 후 다시 시도하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het systeem heeft deze wekker niet geaccepteerd. Verwijder een wekker die je niet meer nodig hebt en probeer het opnieuw."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hệ thống không chấp nhận báo thức này. Hãy xóa một báo thức không còn cần và thử lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "系统未接受此闹钟。请删除不再需要的闹钟，然后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "系統未接受此鬧鐘。請刪除不再需要的鬧鐘，然後再試一次。"
          }
        }
      }
    },
