    "Composer.Footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Wecker klingelt auch, wenn dein Gerät stummgeschaltet oder ein Fokus aktiv ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The alarm rings even when your device is on silent or a Focus is on."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’alarme sonne même si votre appareil est en mode silencieux ou si un mode de concentration est activé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sveglia suona anche se il dispositivo è in modalità silenziosa o è attiva una modalità Full immersion."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デバイスが消音モードでも、集中モードがオンでもアラームが鳴ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기기가 무음 모드이거나 집중 모드가 켜져 있어도 알람이 울립니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De wekker gaat ook af als je apparaat op stil staat of een focus aan staat."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Báo thức vẫn đổ chuông ngay cả khi thiết bị đang ở chế độ im lặng hoặc đang bật chế độ tập trung."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即使设备处于静音模式或开启了专注模式，闹钟也会响铃。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即使裝置處於靜音模式或開啟了專注模式，鬧鐘也會響鈴。"
          }
        }
      }
    },
