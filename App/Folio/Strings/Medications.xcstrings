    "Settings.Empty": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es sind keine Medikamente mit Plan mit Folio geteilt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No medications with a schedule are shared with Folio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun médicament avec un programme n’est partagé avec Folio."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun farmaco con un programma è condiviso con Folio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スケジュールのある服薬はFolioに共有されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio와 공유된, 일정이 있는 약이 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er zijn geen medicijnen met een schema gedeeld met Folio."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có loại thuốc nào có lịch được chia sẻ với Folio."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有与 Folio 共享设有计划的药物。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有與 Folio 分享設有排程的藥物。"
          }
        }
      }
    },
    "Settings.Footer": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt Medikamente mit Plan, die du aus der Health-App teilst. Health teilt den Plan selbst nicht, daher werden kommende Zeiten aus den letzten Einnahmen geschätzt und können falsch sein. Lass die Erinnerungen in Health für jede Dosis aktiviert, die du nicht verpassen darfst. Du erhältst dann beide Hinweise."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows medications with a schedule that you share from the Health app. Health doesn’t share the schedule itself, so upcoming times are estimated from recent doses and may be wrong. Keep the reminders in Health on for any dose you can’t miss. You’ll get both alerts."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche les médicaments avec un programme que vous partagez depuis l’app Santé. Santé ne partage pas le programme lui-même : les prochaines heures sont estimées à partir des prises récentes et peuvent être fausses. Gardez les rappels de Santé activés pour toute prise à ne pas manquer. Vous recevrez les deux alertes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra i farmaci con un programma che condividi dall’app Salute. Salute non condivide il programma, quindi gli orari futuri sono stimati dalle dosi recenti e possono essere errati. Tieni attivi i promemoria di Salute per le dosi da non saltare. Riceverai entrambi gli avvisi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヘルスケアから共有した、スケジュールのある服薬を表示します。ヘルスケアはスケジュール自体を共有しないため、今後の時刻は最近の服用記録から推定され、正しくない場合があります。飲み忘れられない薬は、ヘルスケアのリマインダーもオンのままにしてください。両方の通知が届きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "건강 앱에서 공유한, 일정이 있는 약을 표시합니다. 건강 앱은 일정 자체를 공유하지 않으므로 앞으로의 시간은 최근 복용 기록으로 추정되며 틀릴 수 있습니다. 놓치면 안 되는 약은 건강 앱의 알림도 켜 두세요. 두 알림을 모두 받게 됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toont medicijnen met een schema die je deelt vanuit de Gezondheid-app. Gezondheid deelt het schema zelf niet, dus komende tijden worden geschat op basis van recente doses en kunnen onjuist zijn. Laat de herinneringen in Gezondheid aan staan voor elke dosis die je niet mag missen. Je krijgt dan beide meldingen."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiển thị các loại thuốc có lịch mà bạn chia sẻ từ ứng dụng Sức khỏe. Sức khỏe không chia sẻ chính lịch đó, nên các giờ sắp tới được ước tính từ những liều gần đây và có thể sai. Hãy giữ lời nhắc trong Sức khỏe cho những liều không thể bỏ lỡ. Bạn sẽ nhận được cả hai thông báo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示你从“健康”共享且设有计划的药物。“健康”不会共享计划本身，因此之后的时间是根据近期服药记录估算的，可能不准确。对于不能漏服的药物，请保持“健康”中的提醒开启。你会同时收到两种提醒。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示你從「健康」分享且設有排程的藥物。「健康」不會分享排程本身，因此之後的時間是根據近期用藥紀錄估算，可能不準確。對於不能漏服的藥物，請保持「健康」中的提醒開啟。你會同時收到兩種提醒。"
          }
        }
      }
    },
    "Settings.NotificationsOff": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere alle Mitteilungen, um Erinnerungen zu senden."
