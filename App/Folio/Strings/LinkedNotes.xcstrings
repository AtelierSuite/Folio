    "Settings.Footer": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du eine Notiz für ein Ereignis erstellst, wird ihr Link zur URL des Ereignisses hinzugefügt, damit du die Notiz aus Apple Kalender öffnen kannst. Ereignisse, die bereits eine URL haben oder nicht bearbeitet werden können, bleiben unverändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you create a note for an event, its link is added to the event’s URL so you can open the note from Apple Calendar. Events that already have a URL or can’t be edited are left as they are."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsque vous créez une note pour un événement, son lien est ajouté à l’URL de l’événement pour ouvrir la note depuis Calendrier d’Apple. Les événements qui ont déjà une URL ou qui ne peuvent pas être modifiés restent inchangés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando crei una nota per un evento, il suo link viene aggiunto all’URL dell’evento per aprire la nota da Calendario di Apple. Gli eventi che hanno già un URL o che non possono essere modificati restano invariati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "イベントのメモを作成すると、そのメモへのリンクがイベントのURLに追加され、Appleのカレンダーからメモを開けるようになります。すでにURLがあるイベントや編集できないイベントは変更されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이벤트 메모를 만들면 메모 링크가 이벤트의 URL에 추가되어 Apple 캘린더에서 메모를 열 수 있습니다. 이미 URL이 있거나 편집할 수 없는 이벤트는 그대로 유지됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je een notitie voor een activiteit aanmaakt, wordt de link ervan aan de URL van de activiteit toegevoegd, zodat je de notitie vanuit Apple Agenda kunt openen. Activiteiten die al een URL hebben of niet kunnen worden gewijzigd, blijven ongewijzigd."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi bạn tạo ghi chú cho một sự kiện, liên kết của ghi chú sẽ được thêm vào URL của sự kiện để bạn có thể mở ghi chú từ Lịch của Apple. Các sự kiện đã có URL hoặc không thể sửa sẽ được giữ nguyên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为日程创建笔记时，笔记链接会添加到日程的 URL 中，以便从 Apple 日历打开笔记。已有 URL 或无法编辑的日程保持不变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為行程建立筆記時，筆記連結會加入行程的 URL，讓你可從 Apple 行事曆打開筆記。已有 URL 或無法編輯的行程會保持不變。"
          }
        }
      }
    },
