    "Settings.SnapTo.Footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Termine, die du durch Ziehen verschiebst oder in der Länge änderst, rasten in diesem Abstand ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Events you move or resize by dragging snap to this interval."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les événements déplacés ou redimensionnés en les faisant glisser s’alignent sur cet intervalle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli eventi spostati o ridimensionati trascinandoli si allineano a questo intervallo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ドラッグで移動したり長さを変えたりした予定は、この間隔に揃えられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "드래그해서 옮기거나 길이를 바꾼 이벤트는 이 간격에 맞춰집니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afspraken die je door slepen verplaatst of van lengte verandert, worden op dit interval uitgelijnd."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sự kiện bạn kéo để di chuyển hoặc đổi thời lượng sẽ bắt theo khoảng này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖移或调整长度的日程会对齐到此间隔。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖移或調整長度的行程會對齊到此間隔。"
          }
        }
      }
    }
