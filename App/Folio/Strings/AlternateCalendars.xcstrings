    "Settings.Footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt Daten eines anderen Kalenders neben dem gregorianischen Kalender an, bei jedem Tag und unter dem Monatstitel."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shows dates from another calendar alongside the Gregorian calendar, next to each day and under the month title."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche les dates d’un autre calendrier à côté du calendrier grégorien, près de chaque jour et sous le titre du mois."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra le date di un altro calendario insieme al calendario gregoriano, accanto a ogni giorno e sotto il titolo del mese."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "グレゴリオ暦に加えて別の暦の日付を、各日の横と月のタイトルの下に表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "양력과 함께 다른 달력의 날짜를 각 날짜 옆과 월 제목 아래에 표시합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toont datums uit een andere kalender naast de gregoriaanse kalender, bij elke dag en onder de maandtitel."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiển thị ngày theo một lịch khác bên cạnh lịch Gregory, cạnh mỗi ngày và bên dưới tiêu đề tháng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在公历之外显示另一种历法的日期，位于每一天旁边和月份标题下方。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在公曆之外顯示另一種曆法的日期，位於每一天旁邊和月份標題下方。"
          }
        }
      }
    },
