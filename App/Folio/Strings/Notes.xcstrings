    "Trash.Empty.Description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelöschte Notizen bleiben hier, bis du sie endgültig löschst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notes you delete stay here until you delete them permanently."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notes que vous supprimez restent ici jusqu’à leur suppression définitive."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le note eliminate restano qui finché non le elimini definitivamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除したメモは、完全に削除するまでここに残ります。"
