        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "삭제한 메모는 영구적으로 삭제할 때까지 여기에 보관됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Notities die je verwijdert blijven hier totdat je ze definitief verwijdert."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi chú bạn xóa sẽ ở đây cho đến khi bạn xóa vĩnh viễn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你删除的笔记会保留在这里，直到你将其永久删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你刪除的筆記會保留在這裡，直到你將其永久刪除。"
          }
        }
      }
    },
