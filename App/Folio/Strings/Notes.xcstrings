    "Conflict.Message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Notiz wurde auf einem anderen Gerät oder in einer anderen App bearbeitet. Deine Änderungen wurden als separate Kopie gesichert, damit nichts verloren geht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This note was edited on another device or in another app. Your changes were saved as a separate copy so nothing is lost."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette note a été modifiée sur un autre appareil ou dans une autre app. Vos modifications ont été enregistrées dans une copie distincte pour ne rien perdre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa nota è stata modificata su un altro dispositivo o in un'altra app. Le tue modifiche sono state salvate in una copia separata, quindi non si perde nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このメモはほかのデバイスまたはApp で編集されました。変更内容が失われないよう、別のコピーとして保存しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 메모가 다른 기기나 앱에서 편집되었습니다. 변경 사항이 손실되지 않도록 별도의 사본으로 저장했습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze notitie is op een ander apparaat of in een andere app bewerkt. Je wijzigingen zijn als aparte kopie bewaard, zodat er niets verloren gaat."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi chú này đã được sửa trên thiết bị hoặc ứng dụng khác. Các thay đổi của bạn đã được lưu thành bản sao riêng nên không bị mất."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此笔记已在其他设备或 App 中编辑。你的更改已存储为单独的副本，不会丢失。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此筆記已在其他裝置或 App 中編輯。你的變更已儲存為獨立的副本，不會遺失。"
          }
        }
      }
    },
