    "Unavailable.iCloud.Description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich bei iCloud an oder wähle in den Einstellungen einen anderen Speicherort für Notizen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to iCloud, or choose another place to store notes in Settings."
          }
        },
        "fr": {
