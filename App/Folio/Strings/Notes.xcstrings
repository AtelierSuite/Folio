    "Storage.Footer": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Notizen werden als Markdown-Dateien gesichert. iCloud Drive synchronisiert sie auf deinen Geräten, und mit einem Ordner deiner Wahl kannst du sie mit anderen Apps wie Obsidian teilen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notes are saved as Markdown files. iCloud Drive keeps them in sync across your devices, and a folder of your choice lets you share them with other apps, such as Obsidian."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notes sont enregistrées en fichiers Markdown. iCloud Drive les synchronise sur vos appareils, et un dossier de votre choix permet de les partager avec d’autres apps, comme Obsidian."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le note vengono salvate come file Markdown. iCloud Drive le sincronizza sui tuoi dispositivi e una cartella a scelta ti permette di condividerle con altre app, come Obsidian."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メモはMarkdownファイルとして保存されます。iCloud Driveではデバイス間で同期され、選択したフォルダではObsidianなどほかのAppと共有できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메모는 Markdown 파일로 저장됩니다. iCloud Drive는 기기 간에 메모를 동기화하고, 선택한 폴더를 사용하면 Obsidian 등 다른 앱과 메모를 공유할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Notities worden bewaard als Markdown-bestanden. iCloud Drive houdt ze synchroon op je apparaten en met een map naar keuze kun je ze delen met andere apps, zoals Obsidian."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi chú được lưu dưới dạng tệp Markdown. iCloud Drive đồng bộ ghi chú trên các thiết bị của bạn, còn thư mục bạn chọn cho phép chia sẻ ghi chú với ứng dụng khác như Obsidian."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "笔记会存储为 Markdown 文件。iCloud 云盘可在你的设备间同步笔记，所选文件夹则可让你与 Obsidian 等其他 App 共享笔记。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "筆記會儲存為 Markdown 檔案。iCloud 雲碟可在你的裝置間同步筆記，所選檔案夾則可讓你與 Obsidian 等其他 App 共享筆記。"
          }
        }
      }
    },
    "Storage.Migrate.Message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Notizen, Anhänge und „Zuletzt gelöscht“ können an den neuen Ort umziehen. Notizen aus iCloud Drive oder einem gewählten Ordner werden kopiert und bleiben auch dort. Nichts wird überschrieben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your notes, attachments and Recently Deleted can move to the new location. Notes in iCloud Drive or a chosen folder are copied and also stay where they are. Nothing is overwritten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos notes, pièces jointes et notes supprimées récemment peuvent être transférées vers le nouvel emplacement. Les notes d’iCloud Drive ou d’un dossier choisi sont copiées et restent aussi à leur place. Rien n’est écrasé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le note, gli allegati e le note eliminate di recente possono essere spostati nella nuova posizione. Le note in iCloud Drive o in una cartella scelta vengono copiate e restano anche dove sono. Nulla viene sovrascritto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メモ、添付ファイル、“最近削除した項目”を新しい場所に移動できます。iCloud Driveまたは選択したフォルダ内のメモはコピーされ、元の場所にも残ります。上書きされることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메모, 첨부 파일 및 최근 삭제된 항목을 새로운 위치로 옮길 수 있습니다. iCloud Drive 또는 선택한 폴더의 메모는 복사되며 원래 위치에도 남아 있습니다. 덮어쓰는 항목은 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je notities, bijlagen en Recent verwijderd kunnen naar de nieuwe locatie. Notities in iCloud Drive of een gekozen map worden gekopieerd en blijven ook waar ze zijn. Er wordt niets overschreven."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi chú, tệp đính kèm và mục Đã xóa gần đây có thể được chuyển sang vị trí mới. Ghi chú trong iCloud Drive hoặc thư mục đã chọn sẽ được sao chép và vẫn giữ nguyên ở chỗ cũ. Không có gì bị ghi đè."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的笔记、附件和“最近删除”可以移到新位置。iCloud 云盘或所选文件夹中的笔记会被拷贝，并保留在原处。不会覆盖任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的筆記、附件和「最近刪除」可以移到新位置。iCloud 雲碟或所選檔案夾中的筆記會被拷貝，並保留在原處。不會覆寫任何內容。"
          }
        }
      }
    },
