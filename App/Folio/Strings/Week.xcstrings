          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Werkdagen"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ngày làm việc"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工作日"
          }
        },
        "zh-Hant": {
