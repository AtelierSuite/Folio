{
  "sourceLanguage": "en",
  "strings": {
    "WorkWeek.Calendars.Empty": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube Folio den Zugriff auf deine Kalender und Erinnerungen, um auszuwählen, welche zur Arbeitswoche zählen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Folio to access your calendars and reminders to choose which ones count for the working week."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez Folio à accéder à vos calendriers et rappels pour choisir ceux qui comptent pour la semaine de travail."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti a Folio di accedere ai calendari e ai promemoria per scegliere quali contano per la settimana lavorativa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "平日表示に含めるカレンダーを選ぶには、Folioにカレンダーとリマインダーへのアクセスを許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주중에 포함할 항목을 선택하려면 Folio가 캘린더와 미리 알림에 접근하도록 허용하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geef Folio toegang tot je agenda's en herinneringen om te kiezen welke meetellen voor de werkweek."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho phép Folio truy cập lịch và lời nhắc để chọn những mục được tính vào tuần làm việc."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许 Folio 访问你的日历和提醒事项，以选择哪些计入工作周。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許 Folio 取用你的行事曆和提醒事項，以選擇哪些要計入工作週。"
          }
        }
      }
    },
    "WorkWeek.Section.Calendars": {
