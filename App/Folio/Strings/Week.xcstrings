          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "行事曆"
          }
        }
      }
    },
    "WorkWeek.Section.Calendars.Footer": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In der Arbeitswochenansicht erscheinen nur Ereignisse aus den hier aktivierten Kalendern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only events from the calendars turned on here appear in the working week view."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls les événements des calendriers activés ici apparaissent dans la vue Semaine de travail."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nella vista Settimana lavorativa compaiono solo gli eventi dei calendari attivati qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "平日表示には、ここでオンにしたカレンダーのイベントだけが表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주중 보기에는 여기에서 켠 캘린더의 이벤트만 표시됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen activiteiten uit de agenda's die hier zijn ingeschakeld, verschijnen in de werkweekweergave."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ sự kiện từ các lịch được bật ở đây mới xuất hiện trong chế độ xem tuần làm việc."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工作周视图中只显示此处已打开的日历中的日程。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "工作週視圖只會顯示此處已開啟之行事曆中的行程。"
          }
        }
      }
    },
    "WorkWeek.Section.Days": {
      "extractionState": "manual",
      "localizations": {
