            "state": "translated",
            "value": "工作日"
          }
        }
      }
    },
    "WorkWeek.Section.Days.Footer": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Arbeitswochenansicht zeigt nur diese Tage. Standardmäßig richten sie sich nach dem Wochenende deiner Region."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The working week view shows only these days. By default they follow the weekend of your region."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La vue Semaine de travail n’affiche que ces jours. Par défaut, ils suivent le week-end de votre région."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La vista Settimana lavorativa mostra solo questi giorni. Per impostazione predefinita seguono il fine settimana della tua zona."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "平日表示ではこれらの曜日だけが表示されます。デフォルトでは地域の週末に合わせて設定されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주중 보기에는 이 요일만 표시됩니다. 기본적으로 사용자 지역의 주말에 맞춰 설정됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De werkweekweergave toont alleen deze dagen. Standaard volgen ze het weekend van je regio."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chế độ xem tuần làm việc chỉ hiển thị những ngày này. Theo mặc định, chúng tuân theo ngày cuối tuần của khu vực bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工作周视图只显示这些日子。默认根据你所在地区的周末设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "工作週視圖只會顯示這些日子。預設會依照你所在地區的週末設定。"
          }
        }
      }
    },
