{
  "sourceLanguage": "en",
  "strings": {
    "Settings.Footer": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt bei deiner Ankunft, wann du zum nächsten Termin aufbrechen musst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you arrive somewhere, shows when to leave for your next event."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À votre arrivée quelque part, indique quand partir pour votre prochain évènement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando arrivi da qualche parte, mostra quando partire per il prossimo evento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予定の場所に着くと、次の予定に向けて出発する時間を表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어딘가에 도착하면 다음 일정을 위해 출발할 시간을 보여 줍니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toont bij aankomst wanneer je naar je volgende afspraak moet vertrekken."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi bạn đến nơi, hiển thị giờ cần đi đến sự kiện tiếp theo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "到达某地后，显示前往下一个日程的出发时间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "抵達某地後，顯示前往下一個行程的出發時間。"
          }
        }
      }
    },
    "Settings.Section": {
