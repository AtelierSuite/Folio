    "Settings.Unavailable": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät kann keine Ankünfte erkennen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device can't detect arrivals."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil ne peut pas détecter les arrivées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo dispositivo non può rilevare gli arrivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスは到着を検知できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기는 도착을 감지할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit apparaat kan aankomsten niet detecteren."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thiết bị này không thể phát hiện việc đến nơi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备无法检测到达。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此裝置無法偵測抵達。"
          }
        }
      }
    },
    "Settings.WhenInUse": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufbruchszeit braucht den Standortzugriff „Immer“, damit iOS Folio deine Ankunft auch bei geschlossener App melden kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave By needs location access set to Always, so iOS can tell Folio when you arrive while it's closed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Heure de départ nécessite l’accès Toujours, pour que iOS signale votre arrivée à Folio quand l’app est fermée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ora di partenza richiede l’accesso Sempre, così iOS può segnalare a Folio il tuo arrivo quando l’app è chiusa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「出発時間」には、位置情報へのアクセスを「常に」にする必要があります。Folioを閉じている間も到着を検知するためです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "출발 시간을 사용하려면 위치 접근을 '항상'으로 설정해야 합니다. 그래야 Folio가 닫혀 있어도 도착을 감지할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vertrektijd heeft locatietoegang Altijd nodig, zodat iOS je aankomst aan Folio kan doorgeven als de app dicht is."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giờ khởi hành cần quyền vị trí Luôn luôn để iOS báo cho Folio khi bạn đến nơi lúc ứng dụng đang đóng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“出发时间”需要将位置访问设为“始终”，这样 Folio 关闭时 iOS 也能告知你已到达。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「出發時間」需要將位置取用權設為「永遠」，這樣 Folio 關閉時 iOS 也能告知你已抵達。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
