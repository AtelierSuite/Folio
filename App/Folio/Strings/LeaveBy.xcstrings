    "Settings.WhenInUse": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Leave By widget needs location access set to Always."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「出発時間」ウィジェットには、位置情報へのアクセスを「常に」にする必要があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“出发时间”小组件需要将位置访问设为“始终”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「出發時間」小工具需要將位置取用權設為「永遠」。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "출발 시간 위젯을 사용하려면 위치 접근을 '항상'으로 설정해야 합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le widget Heure de départ nécessite l’accès à la position Toujours."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Widget „Aufbruchszeit“ braucht den Standortzugriff „Immer“."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il widget Ora di partenza richiede l’accesso alla posizione Sempre."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De widget Vertrektijd heeft locatietoegang Altijd nodig."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiện ích Giờ khởi hành cần quyền truy cập vị trí Luôn luôn."
          }
        }
      }
