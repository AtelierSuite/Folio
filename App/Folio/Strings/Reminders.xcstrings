    "Inbox.Empty.Description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erinnerungen ohne Fälligkeitsdatum werden hier angezeigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reminders without a due date appear here."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les rappels sans échéance apparaissent ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I promemoria senza scadenza vengono mostrati qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "期限が設定されていないリマインダーがここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마감일이 없는 미리 알림이 여기에 표시됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herinneringen zonder vervaldatum verschijnen hier."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các lời nhắc không có ngày đến hạn sẽ xuất hiện ở đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有截止日期的提醒事项会显示在这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有到期日的提醒事項會顯示在這裡。"
          }
        }
      }
    },
