        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reminders you haven’t finished can move to today so they stay in view, or stay on the day they were due."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les rappels non terminés peuvent passer à aujourd’hui pour rester visibles, ou rester au jour de leur échéance."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I promemoria non completati possono spostarsi a oggi per restare in vista, oppure rimanere nel giorno di scadenza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完了していないリマインダーを今日に移動して見失わないようにするか、期限日のまま表示するかを選べます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완료하지 않은 미리 알림을 오늘로 옮겨 계속 보이게 하거나, 원래 마감일에 그대로 둘 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herinneringen die je nog niet hebt afgerond, kunnen naar vandaag gaan zodat je ze blijft zien, of op hun vervaldag blijven staan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các lời nhắc chưa hoàn tất có thể chuyển sang hôm nay để luôn hiển thị, hoặc ở lại ngày đến hạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未完成的提醒事项可以移到今天以便随时看到，也可以保留在原来的截止日期。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未完成的提醒事項可以移到今天以便隨時看到，也可以保留在原本的到期日。"
          }
        }
      }
    },
