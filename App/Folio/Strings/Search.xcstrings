    "Settings.Footer": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Termine und erledigte Erinnerungen in diesem Zeitraum sind durchsuchbar. Offene Erinnerungen und Notizen werden immer durchsucht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Events and completed reminders in this range can be searched. Incomplete reminders and notes are always searched."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les événements et rappels terminés de cette période sont recherchables. Les rappels non terminés et les notes le sont toujours."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi cercare eventi e promemoria completati in questo intervallo. Promemoria da completare e note sono sempre inclusi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この期間のイベントと完了済みリマインダーを検索できます。未完了のリマインダーとメモは常に検索対象です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 범위의 이벤트와 완료된 미리 알림을 검색할 수 있습니다. 완료되지 않은 미리 알림과 메모는 항상 검색됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Afspraken en voltooide herinneringen in dit bereik zijn doorzoekbaar. Openstaande herinneringen en notities worden altijd doorzocht."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có thể tìm sự kiện và lời nhắc đã hoàn tất trong khoảng này. Lời nhắc chưa hoàn tất và ghi chú luôn được tìm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可搜索此范围内的日程和已完成的提醒事项。未完成的提醒事项和笔记始终可搜索。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可搜尋此範圍內的行程和已完成的提醒事項。未完成的提醒事項和筆記一律可搜尋。"
          }
        }
      }
    },
