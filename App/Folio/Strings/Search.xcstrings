    "Empty.Description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Finde Termine, Erinnerungen und Notizen anhand von Titel, Ort oder Text."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find events, reminders and notes by their title, location or text."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trouvez des événements, rappels et notes par leur titre, lieu ou texte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trova eventi, promemoria e note per titolo, luogo o testo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイトル、場所、本文でイベント、リマインダー、メモを探せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제목, 위치 또는 텍스트로 이벤트, 미리 알림 및 메모를 찾을 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vind afspraken, herinneringen en notities op titel, locatie of tekst."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tìm sự kiện, lời nhắc và ghi chú theo tiêu đề, địa điểm hoặc nội dung."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按标题、地点或文本查找日程、提醒事项和笔记。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "依標題、地點或內文尋找行程、提醒事項和筆記。"
          }
        }
      }
    },
