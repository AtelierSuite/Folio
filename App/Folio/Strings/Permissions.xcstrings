    "Alarms.Denied.Description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere Wecker für Folio in den Einstellungen, damit sie klingeln können."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on alarms for Folio in Settings so its alarms can ring."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez les alarmes pour Folio dans Réglages pour qu’elles puissent sonner."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva le sveglie per Folio in Impostazioni perché possano suonare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Folioのアラームを鳴らすには、設定でFolioのアラームをオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio의 알람이 울리도록 하려면 설정에서 Folio의 알람을 켜십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet wekkers voor Folio aan in Instellingen zodat ze kunnen afgaan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật báo thức cho Folio trong Cài đặt để báo thức có thể đổ chuông."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“设置”中为 Folio 打开闹钟，以便其闹钟能够响铃。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在「設定」中為 Folio 開啟鬧鐘，以便其鬧鐘能夠響鈴。"
          }
        }
      }
    },
