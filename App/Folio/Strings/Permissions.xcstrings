    "Location.Denied.Description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere den Standortzugriff für Folio in den Einstellungen, um ortsbezogene Erinnerungen zu nutzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on location access for Folio in Settings to use place-based reminders."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez l’accès à la position pour Folio dans Réglages pour utiliser les rappels liés à un lieu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva l’accesso alla posizione per Folio in Impostazioni per usare i promemoria basati sul luogo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "場所に基づくリマインダーを使うには、設定でFolioの位置情報へのアクセスをオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "장소 기반 미리 알림을 사용하려면 설정에서 Folio의 위치 접근을 켜십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet locatietoegang voor Folio aan in Instellingen om herinneringen op basis van locatie te gebruiken."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật quyền truy cập vị trí cho Folio trong Cài đặt để dùng lời nhắc theo địa điểm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“设置”中为 Folio 打开位置访问权限，以使用基于地点的提醒。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在「設定」中為 Folio 開啟位置取用權限，以使用依據地點的提醒。"
          }
        }
      }
    },
