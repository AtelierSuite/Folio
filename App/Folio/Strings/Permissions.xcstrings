    "Calendar.Denied.Description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere in den Einstellungen den vollen Kalenderzugriff für Folio, um deine Termine hier zu sehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on full calendar access for Folio in Settings to see your events here."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez l’accès complet au calendrier pour Folio dans Réglages pour voir vos événements ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva l’accesso completo al calendario per Folio in Impostazioni per vedere qui i tuoi eventi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここにイベントを表示するには、設定でFolioのカレンダーへのフルアクセスをオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기에서 이벤트를 보려면 설정에서 Folio의 캘린더 전체 접근을 켜십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet volledige agendatoegang voor Folio aan in Instellingen om je activiteiten hier te zien."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật quyền truy cập đầy đủ vào lịch cho Folio trong Cài đặt để xem sự kiện tại đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“设置”中为 Folio 打开日历完全访问权限，以便在此查看日程。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在「設定」中為 Folio 開啟行事曆完整取用權限，以便在此檢視行程。"
          }
        }
      }
    },
