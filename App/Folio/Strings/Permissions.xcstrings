    "Calendar.Request.Description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio zeigt deine Termine neben deinen Erinnerungen und Notizen. Erlaube den Zugriff, um sie hier zu sehen und zu bearbeiten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio shows your events next to your reminders and notes. Allow access to see and edit them here."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio affiche vos événements à côté de vos rappels et notes. Autorisez l’accès pour les voir et les modifier ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio mostra i tuoi eventi accanto a promemoria e note. Consenti l’accesso per vederli e modificarli qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Folioはイベントをリマインダーやメモと並べて表示します。ここで表示・編集するにはアクセスを許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio는 이벤트를 미리 알림 및 메모와 함께 표시합니다. 여기에서 보고 편집하려면 접근을 허용하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio toont je activiteiten naast je herinneringen en notities. Sta toegang toe om ze hier te bekijken en te wijzigen."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio hiển thị sự kiện cùng với lời nhắc và ghi chú của bạn. Cho phép truy cập để xem và sửa chúng tại đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio 会将你的日程与提醒事项和备忘录一起显示。允许访问即可在此查看和编辑日程。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio 會將你的行程與提醒事項和備忘錄一起顯示。允許取用即可在此檢視和編輯行程。"
          }
        }
      }
    },
