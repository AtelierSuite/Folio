            "value": "Sta toegang tot Locatievoorzieningen toe om met je huidige locatie de reistijd naar je activiteiten te schatten."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để dùng vị trí hiện tại nhằm ước tính thời gian di chuyển đến sự kiện, hãy cho phép truy cập Dịch vụ định vị."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "若要使用当前位置来估算前往日程的行程时间，请允许访问定位服务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "若要使用目前位置來估算前往行程的交通時間，請允許取用定位服務。"
          }
        }
      }
    },
    "Prompt.WakeUpTravelTime": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um mit deinem aktuellen Standort die Fahrzeit in deinen Weckalarm einzurechnen, erlaube den Zugriff auf die Ortungsdienste."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To use your current location to add travel time to your wake-up alarm, allow access to Location Services."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour utiliser votre position actuelle afin d’ajouter le temps de trajet à votre alarme de réveil, autorisez l’accès au service de localisation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per usare la tua posizione attuale per aggiungere il tempo di viaggio alla sveglia mattutina, consenti l’accesso a Localizzazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在地を使って目覚ましアラームに移動時間を加えるには、位置情報サービスへのアクセスを許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 위치를 사용해 기상 알람에 이동 시간을 더하려면 위치 서비스 접근을 허용하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sta toegang tot Locatievoorzieningen toe om met je huidige locatie reistijd aan je wekker toe te voegen."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để dùng vị trí hiện tại nhằm cộng thời gian di chuyển vào báo thức dậy, hãy cho phép truy cập Dịch vụ định vị."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "若要使用当前位置为起床闹钟加上行程时间，请允许访问定位服务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
