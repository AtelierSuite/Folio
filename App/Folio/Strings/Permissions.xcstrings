    "Reminders.Request.Description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio zeigt deine Erinnerungen neben deinen Terminen. Erlaube den Zugriff, um sie hier zu sehen und abzuhaken."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio shows your reminders alongside your events. Allow access to see and complete them here."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio affiche vos rappels à côté de vos événements. Autorisez l’accès pour les voir et les terminer ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio mostra i tuoi promemoria accanto agli eventi. Consenti l’accesso per vederli e completarli qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Folioはリマインダーをイベントと一緒に表示します。ここで表示・完了するにはアクセスを許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio는 미리 알림을 이벤트와 함께 표시합니다. 여기에서 보고 완료하려면 접근을 허용하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio toont je herinneringen naast je activiteiten. Sta toegang toe om ze hier te bekijken en af te ronden."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio hiển thị lời nhắc cùng với sự kiện của bạn. Cho phép truy cập để xem và hoàn tất chúng tại đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio 会将你的提醒事项与日程一起显示。允许访问即可在此查看和完成提醒事项。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio 會將你的提醒事項與行程一起顯示。允許取用即可在此檢視和完成提醒事項。"
          }
        }
      }
    },
