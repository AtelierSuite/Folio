    "Health.Request.Description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube Folio, deine Schlafdaten aus Health zu lesen, um sie in deiner Zeitleiste zu zeigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Folio to read your sleep data from Health to show it on your timeline."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez Folio à lire vos données de sommeil dans Santé pour les afficher sur votre chronologie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti a Folio di leggere i dati sul sonno da Salute per mostrarli nella tua timeline."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイムラインに睡眠を表示するには、Folioにヘルスケアの睡眠データの読み取りを許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "타임라인에 수면을 표시하려면 Folio가 건강 앱의 수면 데이터를 읽도록 허용하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sta Folio toe je slaapgegevens uit Gezondheid te lezen om ze op je tijdlijn te tonen."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho phép Folio đọc dữ liệu giấc ngủ từ Sức khỏe để hiển thị trên dòng thời gian."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许 Folio 读取“健康”中的睡眠数据，以便在时间线上显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許 Folio 讀取「健康」中的睡眠資料，以便在時間線上顯示。"
          }
        }
      }
    },
