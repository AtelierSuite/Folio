    "Contacts.Request.Description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube den Zugriff auf Kontakte, damit das Widget „Terminnotizen“ Fotos und Namen der Teilnehmer zeigen kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow access to Contacts so the Event Notes widget can show the photos and names of the people attending."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez l’accès aux contacts pour que le widget Notes d’événement affiche les photos et les noms des participants."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti l’accesso ai contatti per mostrare foto e nomi dei partecipanti nel widget Note evento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "連絡先へのアクセスを許可すると、「予定メモ」ウィジェットに参加者の写真と名前を表示できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연락처 접근을 허용하면 일정 메모 위젯에 참석자의 사진과 이름을 표시할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geef toegang tot Contacten zodat de widget Afspraaknotities foto’s en namen van deelnemers kan tonen."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho phép truy cập Danh bạ để tiện ích Ghi chú sự kiện hiển thị ảnh và tên người tham dự."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许访问通讯录，“日程备注”小组件即可显示参加者的照片和姓名。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許取用聯絡人，「行程備註」小工具即可顯示參加者的照片和姓名。"
          }
        }
      }
    },
