    "Health.Denied.Description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du hier Schlafdaten erwartet hast, prüfe in der Health-App, ob Folio Schlaf lesen darf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you expected sleep data here, check that Folio is allowed to read Sleep in the Health app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous attendiez des données de sommeil ici, vérifiez que Folio peut lire Sommeil dans l’app Santé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ti aspettavi dati sul sonno, verifica nell’app Salute che Folio possa leggere Sonno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここに睡眠データが表示されるはずの場合は、ヘルスケアAppでFolioが睡眠を読み取れるか確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기에 수면 데이터가 있어야 한다면 건강 앱에서 Folio가 수면을 읽을 수 있는지 확인하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je hier slaapgegevens verwachtte, controleer dan in de Gezondheid-app of Folio Slaap mag lezen."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu bạn mong đợi có dữ liệu giấc ngủ ở đây, hãy kiểm tra xem Folio có được phép đọc Giấc ngủ trong ứng dụng Sức khỏe không."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果你预期此处有睡眠数据，请在“健康” App 中检查 Folio 是否被允许读取睡眠。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果你預期此處有睡眠資料，請在「健康」App 中檢查 Folio 是否被允許讀取睡眠。"
          }
        }
      }
    },
