    "Location.Request.Description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube den Standortzugriff, damit Folio dich erinnert, wenn du an einem Ort ankommst oder ihn verlässt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow location access so Folio can remind you when you arrive at or leave a place."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez l’accès à la position pour que Folio vous rappelle quand vous arrivez dans un lieu ou le quittez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti l’accesso alla posizione per ricevere promemoria da Folio quando arrivi o lasci un luogo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "位置情報へのアクセスを許可すると、場所に到着したときや出発したときにFolioが通知します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위치 접근을 허용하면 장소에 도착하거나 떠날 때 Folio가 알려 줍니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sta locatietoegang toe zodat Folio je kan herinneren wanneer je op een plek aankomt of vertrekt."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho phép truy cập vị trí để Folio nhắc bạn khi bạn đến hoặc rời một địa điểm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许访问位置后，Folio 可以在你到达或离开某个地点时提醒你。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許取用位置後，Folio 可以在你抵達或離開某個地點時提醒你。"
          }
        }
      }
    },
