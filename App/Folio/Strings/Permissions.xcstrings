    "Restricted.Description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Zugriff ist auf diesem Gerät eingeschränkt, zum Beispiel durch Bildschirmzeit oder ein Verwaltungsprofil."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This access is restricted on this device, for example by Screen Time or a device management profile."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet accès est limité sur cet appareil, par exemple par Temps d’écran ou un profil de gestion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo accesso è limitato su questo dispositivo, ad esempio da Tempo di utilizzo o da un profilo di gestione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアクセスは、スクリーンタイムやデバイス管理プロファイルなどによってこのデバイスで制限されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 접근은 스크린 타임이나 기기 관리 프로파일 등으로 인해 이 기기에서 제한되어 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze toegang is beperkt op dit apparaat, bijvoorbeeld door Schermtijd of een beheerprofiel."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quyền truy cập này bị hạn chế trên thiết bị, ví dụ do Thời gian sử dụng hoặc hồ sơ quản lý thiết bị."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此访问权限在这台设备上受到限制，例如由于屏幕使用时间或设备管理描述文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此取用權限在這部裝置上受到限制，例如因為螢幕使用時間或裝置管理描述檔。"
          }
        }
      }
    },
    "Settings.Footer": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio fragt nach jeder Berechtigung erst, wenn du die Funktion, die sie braucht, zum ersten Mal verwendest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio asks for each permission only when you first use the feature that needs it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio demande chaque autorisation uniquement lorsque vous utilisez pour la première fois la fonction qui en a besoin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio chiede ogni autorizzazione solo quando usi per la prima volta la funzione che la richiede."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Folioは、各アクセス許可が必要な機能を初めて使うときにだけ許可を求めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio는 권한이 필요한 기능을 처음 사용할 때만 해당 권한을 요청합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio vraagt elke toestemming pas wanneer je de functie die hem nodig heeft voor het eerst gebruikt."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio chỉ xin từng quyền khi bạn dùng lần đầu tính năng cần đến quyền đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio 仅在你首次使用需要某项权限的功能时才会请求该权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio 僅在你首次使用需要某項權限的功能時才會要求該權限。"
          }
        }
      }
    },
