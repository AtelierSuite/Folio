    "Reminders.Denied.Description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere in den Einstellungen den vollen Zugriff auf Erinnerungen für Folio, um sie hier zu sehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on full reminders access for Folio in Settings to see your reminders here."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez l’accès complet aux rappels pour Folio dans Réglages pour voir vos rappels ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva l’accesso completo ai promemoria per Folio in Impostazioni per vederli qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここにリマインダーを表示するには、設定でFolioのリマインダーへのフルアクセスをオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기에서 미리 알림을 보려면 설정에서 Folio의 미리 알림 전체 접근을 켜십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet volledige toegang tot herinneringen voor Folio aan in Instellingen om ze hier te zien."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật quyền truy cập đầy đủ vào lời nhắc cho Folio trong Cài đặt để xem lời nhắc tại đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“设置”中为 Folio 打开提醒事项完全访问权限，以便在此查看提醒事项。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在「設定」中為 Folio 開啟提醒事項完整取用權限，以便在此檢視提醒事項。"
          }
        }
      }
    },
