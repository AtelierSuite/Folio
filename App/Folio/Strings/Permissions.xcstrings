    "Alarms.Request.Description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube Folio, Wecker zu stellen, die auch im Stummmodus oder in einem Fokus klingeln."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Folio to schedule alarms that ring even in Silent mode or a Focus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez Folio à programmer des alarmes qui sonnent même en mode silencieux ou en mode Concentration."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti a Folio di impostare sveglie che suonano anche in modalità silenziosa o con una Full immersion attiva."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "消音モードや集中モード中でも鳴るアラームをFolioが設定できるように許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무음 모드나 집중 모드에서도 울리는 알람을 Folio가 설정할 수 있도록 허용하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sta Folio toe wekkers in te stellen die ook afgaan in de stille modus of een focus."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho phép Folio đặt báo thức đổ chuông ngay cả ở chế độ im lặng hoặc khi bật Tập trung."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许 Folio 设置即使在静音模式或专注模式下也会响铃的闹钟。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許 Folio 設定即使在靜音模式或專注模式下也會響鈴的鬧鐘。"
          }
        }
      }
    },
