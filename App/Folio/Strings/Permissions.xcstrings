    "Contacts.Denied.Description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere den Kontaktzugriff für Folio in den Einstellungen, um Fotos der Teilnehmer zu zeigen. Sonst nutzt Folio die Namen aus dem Termin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on Contacts access for Folio in Settings to show attendees' photos. Without it, Folio uses the names on the event."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez l’accès aux contacts pour Folio dans Réglages afin d’afficher les photos des participants. Sinon, Folio utilise les noms de l’événement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva l’accesso ai contatti per Folio in Impostazioni per mostrare le foto dei partecipanti. Altrimenti Folio usa i nomi dell’evento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "参加者の写真を表示するには、設定でFolioの連絡先へのアクセスをオンにしてください。オフの場合は、イベントに記載された名前を使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "참석자 사진을 표시하려면 설정에서 Folio의 연락처 접근을 켜세요. 꺼져 있으면 이벤트에 있는 이름을 사용합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet toegang tot Contacten voor Folio aan in Instellingen om foto’s van deelnemers te tonen. Anders gebruikt Folio de namen uit de afspraak."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật quyền truy cập Danh bạ cho Folio trong Cài đặt để hiển thị ảnh người tham dự. Nếu không, Folio dùng tên trong sự kiện."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“设置”中为 Folio 打开通讯录访问以显示参加者照片。否则 Folio 将使用日程中的姓名。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在「設定」中為 Folio 開啟聯絡人取用權以顯示參加者照片。否則 Folio 會使用行程中的姓名。"
          }
        }
      }
    },
