    "Notifications.Denied.Description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere Mitteilungen für Folio in den Einstellungen, um Hinweise zu erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on notifications for Folio in Settings to get alerts."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez les notifications pour Folio dans Réglages pour recevoir des alertes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva le notifiche per Folio in Impostazioni per ricevere avvisi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知を受け取るには、設定でFolioの通知をオンにしてください。"
