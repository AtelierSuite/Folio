    "Notifications.Request.Description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube Mitteilungen, damit Folio dich an anstehende Termine und Aufgaben erinnern kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow notifications so Folio can alert you about upcoming events and tasks."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez les notifications pour que Folio vous prévienne des événements et tâches à venir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti le notifiche per ricevere da Folio avvisi su eventi e attività in arrivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知を許可すると、Folioが今後のイベントやタスクをお知らせします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림을 허용하면 Folio가 다가오는 이벤트와 작업을 알려 줍니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sta meldingen toe zodat Folio je kan waarschuwen voor komende activiteiten en taken."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho phép thông báo để Folio có thể nhắc bạn về các sự kiện và công việc sắp tới."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许通知后，Folio 可以提醒你即将到来的日程和任务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許通知後，Folio 可以提醒你即將到來的行程和工作。"
          }
        }
      }
    },
