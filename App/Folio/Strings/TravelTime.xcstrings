    "Settings.Footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt direkt über jedem Termin im Kalender, wie lange du von deinem Standort zu anstehenden Terminen mit Ort brauchst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shows how long it takes to get from where you are to upcoming events that have a location, just above each event in the calendar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indique le temps nécessaire pour vous rendre de l’endroit où vous êtes aux prochains événements qui ont un lieu, juste au-dessus de chaque événement dans le calendrier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra quanto tempo serve per arrivare da dove ti trovi ai prossimi eventi con un luogo, appena sopra ogni evento nel calendario."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在地から場所が設定された今後の予定までの移動時間を、カレンダーの各予定のすぐ上に表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 위치에서 장소가 지정된 다가오는 일정까지 걸리는 시간을 캘린더의 각 일정 바로 위에 표시합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toont direct boven elk agenda-item hoelang je erover doet om van je huidige locatie naar komende items met een locatie te gaan."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiển thị thời gian để đi từ vị trí hiện tại của bạn đến các sự kiện sắp tới có địa điểm, ngay phía trên mỗi sự kiện trong lịch."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在日历中每个日程的上方，显示从你当前所在位置前往即将开始且设有地点的日程所需的时间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在行事曆中每個活動的上方，顯示從你目前所在位置前往即將開始且設有地點的活動所需的時間。"
          }
        }
      }
    },
