    "Settings.LocationDenied" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folio braucht Zugriff auf deinen Standort, um Fahrzeiten zu berechnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folio needs access to your location to work out travel times."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folio a besoin d’accéder à votre position pour calculer les temps de trajet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folio ha bisogno di accedere alla tua posizione per calcolare i tempi di viaggio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移動時間を計算するには、Folioに位置情報へのアクセスを許可する必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이동 시간을 계산하려면 Folio가 위치에 접근할 수 있어야 합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folio heeft toegang tot je locatie nodig om reistijden te berekenen."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folio cần quyền truy cập vị trí của bạn để tính thời gian di chuyển."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folio 需要访问你的位置才能计算行程时间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folio 需要取用你的位置才能計算交通時間。"
          }
        }
      }
