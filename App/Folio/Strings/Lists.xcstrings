{
  "sourceLanguage": "en",
  "strings": {
    "Empty.Description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Listen, die du in Erinnerungen erstellst, werden hier angezeigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lists you create in Reminders appear here."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les listes que vous créez dans Rappels apparaissent ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli elenchi creati in Promemoria vengono visualizzati qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リマインダーで作成したリストがここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미리 알림에서 만든 목록이 여기에 표시됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lijsten die je in Herinneringen aanmaakt, worden hier weergegeven."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các danh sách bạn tạo trong Lời nhắc sẽ xuất hiện ở đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你在“提醒事项”中创建的列表会显示在这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你在「提醒事項」中建立的列表會顯示在這裡。"
          }
        }
      }
    },
    "Empty.Title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Listen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Lists"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune liste"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun elenco"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リストがありません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목록 없음"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen lijsten"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có danh sách"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有列表"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有列表"
          }
        }
      }
    },
    "List.Empty.Description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erinnerungen, die du zu dieser Liste hinzufügst, werden hier angezeigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reminders you add to this list appear here."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les rappels que vous ajoutez à cette liste apparaissent ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I promemoria che aggiungi a questo elenco vengono visualizzati qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このリストに追加したリマインダーがここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 목록에 추가한 미리 알림이 여기에 표시됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herinneringen die je aan deze lijst toevoegt, worden hier weergegeven."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lời nhắc bạn thêm vào danh sách này sẽ xuất hiện ở đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你添加到此列表的提醒事项会显示在这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你加入此列表的提醒事項會顯示在這裡。"
          }
        }
      }
    },
