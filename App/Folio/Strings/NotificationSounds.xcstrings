    "Section.Footer": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalender und Listen ohne eigenen Ton verwenden den Standardton."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendars and lists without their own sound use the default."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les calendriers et listes sans son propre utilisent le son par défaut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I calendari e gli elenchi senza un suono proprio usano quello predefinito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サウンドを設定していないカレンダーやリストでは、デフォルトのサウンドが使われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사운드를 설정하지 않은 캘린더와 목록에는 기본 사운드가 사용됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenda's en lijsten zonder eigen geluid gebruiken het standaardgeluid."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lịch và danh sách không có âm thanh riêng sẽ dùng âm thanh mặc định."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未设置提示音的日历和列表将使用默认提示音。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未設定提示聲的行事曆和列表會使用預設提示聲。"
          }
        }
      }
    },
