    "Settings.Footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wochenenden sind die Tage außerhalb deiner Arbeitswoche. Feiertage werden in Japan vom Cabinet Office, im Vereinigten Königreich von GOV.UK (England und Wales) und anderswo von Nager.Date geladen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weekends are the days outside your work week. Holidays are downloaded from the Cabinet Office in Japan, GOV.UK in the United Kingdom (England and Wales) and Nager.Date elsewhere."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les week-ends sont les jours hors de votre semaine de travail. Les jours fériés sont téléchargés depuis le Cabinet Office au Japon, GOV.UK au Royaume-Uni (Angleterre et pays de Galles) et Nager.Date ailleurs."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I fine settimana sono i giorni fuori dalla tua settimana lavorativa. Le festività vengono scaricate dal Cabinet Office in Giappone, da GOV.UK nel Regno Unito (Inghilterra e Galles) e da Nager.Date altrove."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "週末は勤務週に含まれない日です。祝日は、日本では内閣府、イギリスではGOV.UK（イングランドおよびウェールズ）、その他の地域ではNager.Dateからダウンロードされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "주말은 근무 주에 포함되지 않는 날입니다. 공휴일은 일본은 내각부, 영국은 GOV.UK(잉글랜드 및 웨일스), 그 외 지역은 Nager.Date에서 다운로드됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weekenden zijn de dagen buiten je werkweek. Feestdagen worden in Japan gedownload van het Cabinet Office, in het Verenigd Koninkrijk van GOV.UK (Engeland en Wales) en elders van Nager.Date."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuối tuần là những ngày ngoài tuần làm việc của bạn. Ngày lễ được tải về từ Văn phòng Nội các ở Nhật Bản, GOV.UK ở Vương quốc Anh (Anh và Xứ Wales) và Nager.Date ở các nơi khác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "周末是指工作周以外的日子。节假日数据在日本从内阁府下载，在英国从 GOV.UK（英格兰和威尔士）下载，其他地区从 Nager.Date 下载。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "週末是指工作週以外的日子。假日資料在日本從內閣府下載，在英國從 GOV.UK（英格蘭和威爾斯）下載，其他地區從 Nager.Date 下載。"
          }
        }
      }
    },
