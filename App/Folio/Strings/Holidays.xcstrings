    "Settings.RefreshFailedMessage" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Überprüfe deine Internetverbindung und versuche es erneut. Bereits geladene Feiertage werden weiterhin angezeigt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check your internet connection and try again. Previously downloaded holidays are still shown."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifiez votre connexion Internet et réessayez. Les jours fériés déjà téléchargés restent affichés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controlla la connessione a Internet e riprova. Le festività già scaricate restano visibili."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "インターネット接続を確認して、もう一度お試しください。以前にダウンロードした祝日は引き続き表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "인터넷 연결을 확인한 후 다시 시도하십시오. 이전에 다운로드한 공휴일은 계속 표시됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controleer je internetverbinding en probeer het opnieuw. Eerder gedownloade feestdagen blijven zichtbaar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy kiểm tra kết nối Internet và thử lại. Các ngày lễ đã tải trước đó vẫn được hiển thị."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请检查你的互联网连接，然后重试。之前下载的节假日仍会显示。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請檢查你的網際網路連線，然後再試一次。先前下載的假日仍會顯示。"
          }
        }
      }
    },
