    "Settings.Unavailable" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für deine Region sind keine Feiertage verfügbar. Wähle eine Feiertagsregion, um sie anzuzeigen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Holidays aren't available for your region. Choose a holiday region to show them."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les jours fériés ne sont pas disponibles pour votre région. Choisissez une région pour les afficher."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le festività non sono disponibili per la tua regione. Scegli una regione per mostrarle."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "お使いの地域の祝日は利用できません。表示するには祝日の地域を選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 지역의 공휴일을 사용할 수 없습니다. 표시하려면 공휴일 지역을 선택하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feestdagen zijn niet beschikbaar voor je regio. Kies een regio om ze te tonen."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không có ngày lễ cho khu vực của bạn. Hãy chọn khu vực ngày lễ để hiển thị."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你所在的地区没有可用的节假日。请选择一个节假日地区以显示。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你所在的地區沒有可用的假日。請選擇一個假日地區以顯示。"
          }
        }
      }
