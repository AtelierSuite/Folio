{
  "sourceLanguage": "en",
  "strings": {
    "Access.Message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne Folio, um den Zugriff auf deine Kalender und Erinnerungen zu erlauben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Folio to allow access to your calendars and reminders."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez Folio pour autoriser l’accès à vos calendriers et rappels."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri Folio per consentire l’accesso ai tuoi calendari e promemoria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Folioを開いて、カレンダーとリマインダーへのアクセスを許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio를 열어 캘린더와 미리 알림에 대한 접근을 허용하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Folio om toegang tot je agenda’s en herinneringen toe te staan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở Folio để cho phép truy cập lịch và lời nhắc của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 Folio 以允许访问你的日历和提醒事项。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打開 Folio 以允許取用你的行事曆和提醒事項。"
          }
        }
      }
    },
    "Access.Title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Kalenderzugriff"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Calendar Access"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun accès au calendrier"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun accesso al calendario"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カレンダーへのアクセスがありません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캘린더 접근 권한 없음"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen toegang tot agenda"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có quyền truy cập lịch"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法访问日历"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法取用行事曆"
          }
        }
      }
    },
