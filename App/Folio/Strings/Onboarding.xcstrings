    "Feature.Calendar.Description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieh Termine und Erinnerungen in einer Zeitleiste, von einem Tag bis zu einem ganzen Monat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See events and reminders on one timeline, from a single day to a whole month."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Visualisez événements et rappels sur une seule chronologie, d’une journée à un mois entier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vedi eventi e promemoria in un’unica timeline, da un solo giorno a un mese intero."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "イベントとリマインダーをひとつのタイムラインで。1日から1か月まで表示できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이벤트와 미리 알림을 하나의 타임라인에서 하루부터 한 달까지 확인하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekijk activiteiten en herinneringen op één tijdlijn, van één dag tot een hele maand."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xem sự kiện và lời nhắc trên một dòng thời gian, từ một ngày đến cả tháng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在同一条时间线上查看日程和提醒事项，从一天到整个月。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在同一條時間線上檢視行程和提醒事項，從一天到整個月。"
          }
        }
      }
    },
    "Feature.Calendar.Title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Plane deine Tage"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plan Your Days"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Planifiez vos journées"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pianifica le tue giornate"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎日を計画"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하루를 계획하세요"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plan je dagen"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lên kế hoạch cho từng ngày"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "规划每一天"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "規劃每一天"
          }
        }
      }
    },
    "Feature.Notes.Description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreibe Notizen in Markdown und behalte sie neben deinen Plänen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write notes in Markdown and keep them next to your plans."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rédigez vos notes en Markdown et gardez-les à côté de vos projets."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrivi note in Markdown e tienile accanto ai tuoi piani."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Markdownでメモを書き、予定のそばに置いておけます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Markdown으로 메모를 작성하고 일정 옆에 두세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schrijf notities in Markdown en houd ze bij je planning."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Viết ghi chú bằng Markdown và đặt chúng ngay cạnh kế hoạch của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用 Markdown 写备忘录，并将其放在你的计划旁边。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用 Markdown 寫備忘錄，並將其放在你的計畫旁邊。"
          }
        }
      }
    },
    "Feature.Notes.Title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Notizen immer zur Hand"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep Notes Close"
          }
        },
        "fr": {
