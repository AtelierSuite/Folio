    "Setup.Sleep.Description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio kann deinen Schlaf aus der Health-App neben deinen Plänen anzeigen. Erlaube den Zugriff auf Health, um ihn in deinem Kalender zu sehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio can show your sleep from the Health app next to your plans. Allow access to Health to see it on your calendar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio peut afficher votre sommeil depuis l’app Santé à côté de vos projets. Autorisez l’accès à Santé pour le voir sur votre calendrier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio può mostrare il sonno dall’app Salute accanto ai tuoi programmi. Consenti l’accesso a Salute per vederlo sul calendario."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Folioでは、ヘルスケアAppの睡眠データを予定と並べて表示できます。カレンダーに表示するには、ヘルスケアへのアクセスを許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio는 건강 앱의 수면 데이터를 계획과 나란히 표시할 수 있습니다. 캘린더에서 보려면 건강 접근을 허용하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio kan je slaap uit de Gezondheid-app naast je plannen tonen. Sta toegang tot Gezondheid toe om die in je agenda te zien."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio có thể hiển thị giấc ngủ từ ứng dụng Sức khỏe bên cạnh các kế hoạch của bạn. Hãy cho phép truy cập Sức khỏe để xem trên lịch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio 可以将“健康”App 中的睡眠数据与你的计划并排显示。若要在日历上查看，请允许访问“健康”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio 可以將「健康」App 中的睡眠資料與你的計畫並排顯示。若要在行事曆上查看，請允許取用「健康」。"
          }
        }
      }
    },
