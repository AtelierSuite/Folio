    "Feature.Calendar.Description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieh Termine und Erinnerungen in einer Zeitleiste, von einem Tag bis zu einem ganzen Monat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See events and reminders on one timeline, from a single day to a whole month."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Visualisez événements et rappels sur une seule chronologie, d’une journée à un mois entier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vedi eventi e promemoria in un’unica timeline, da un solo giorno a un mese intero."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "イベントとリマインダーをひとつのタイムラインで。1日から1か月まで表示できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이벤트와 미리 알림을 하나의 타임라인에서 하루부터 한 달까지 확인하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekijk activiteiten en herinneringen op één tijdlijn, van één dag tot een hele maand."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xem sự kiện và lời nhắc trên một dòng thời gian, từ một ngày đến cả tháng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在同一条时间线上查看日程和提醒事项，从一天到整个月。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在同一條時間線上檢視行程和提醒事項，從一天到整個月。"
          }
        }
      }
    },
    "Feature.Calendar.Title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Plane deine Tage"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plan Your Days"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Planifiez vos journées"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pianifica le tue giornate"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎日を計画"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하루를 계획하세요"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plan je dagen"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lên kế hoạch cho từng ngày"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "规划每一天"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "規劃每一天"
          }
        }
      }
    },
    "Feature.Notes.Description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreibe Notizen in Markdown und behalte sie neben deinen Plänen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write notes in Markdown and keep them next to your plans."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rédigez vos notes en Markdown et gardez-les à côté de vos projets."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrivi note in Markdown e tienile accanto ai tuoi piani."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Markdownでメモを書き、予定のそばに置いておけます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Markdown으로 메모를 작성하고 일정 옆에 두세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schrijf notities in Markdown en houd ze bij je planning."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Viết ghi chú bằng Markdown và đặt chúng ngay cạnh kế hoạch của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用 Markdown 写备忘录，并将其放在你的计划旁边。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用 Markdown 寫備忘錄，並將其放在你的計畫旁邊。"
          }
        }
      }
    },
    "Feature.Notes.Title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Notizen immer zur Hand"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep Notes Close"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez vos notes à portée"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Note sempre a portata di mano"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メモをすぐそばに"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메모를 가까이에"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Notities binnen handbereik"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi chú luôn trong tầm tay"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "随手记录"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "隨手記錄"
          }
        }
      }
    },
    "Feature.Privacy.Description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio fragt erst nach Zugriff auf Kalender, Erinnerungen und andere Daten, wenn du eine Funktion, die ihn braucht, zum ersten Mal verwendest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio asks for access to your calendars, reminders and other data only when you first use a feature that needs it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio demande l’accès à vos calendriers, rappels et autres données uniquement lorsque vous utilisez pour la première fois une fonction qui en a besoin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio chiede l’accesso a calendari, promemoria e altri dati solo quando usi per la prima volta una funzione che lo richiede."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Folioがカレンダーやリマインダーなどへのアクセスを求めるのは、それが必要な機能を初めて使うときだけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio는 캘린더, 미리 알림 및 기타 데이터에 대한 접근이 필요한 기능을 처음 사용할 때만 접근을 요청합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio vraagt pas toegang tot je agenda's, herinneringen en andere gegevens wanneer je voor het eerst een functie gebruikt die dat nodig heeft."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio chỉ xin quyền truy cập lịch, lời nhắc và dữ liệu khác khi bạn dùng lần đầu một tính năng cần đến chúng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio 仅在你首次使用需要访问日历、提醒事项或其他数据的功能时才会请求访问。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio 僅在你首次使用需要取用行事曆、提醒事項或其他資料的功能時才會要求取用。"
          }
        }
      }
    },
    "Feature.Privacy.Title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du behältst die Kontrolle"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You Stay in Control"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous gardez le contrôle"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai sempre il controllo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いつでもあなたが管理"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 것을 직접 관리하세요"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jij houdt de regie"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn luôn kiểm soát"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一切由你掌控"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一切由你掌控"
          }
        }
      }
    },
    "Welcome.Subtitle": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Kalender, deine Erinnerungen und Notizen, vereint in einem Planer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your calendar, reminders and notes, together in one planner."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre calendrier, vos rappels et vos notes, réunis dans un seul agenda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendario, promemoria e note, insieme in un’unica agenda."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カレンダー、リマインダー、メモをひとつのプランナーに。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캘린더, 미리 알림, 메모를 하나의 플래너에서."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je agenda, herinneringen en notities, samen in één planner."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lịch, lời nhắc và ghi chú của bạn, gói gọn trong một trình lập kế hoạch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "日历、提醒事项和备忘录，汇集在一个计划工具中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "行事曆、提醒事項和備忘錄，匯集在一個規劃工具中。"
          }
        }
      }
    },
