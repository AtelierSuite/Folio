    "Setup.Reminders.Description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio kann deine Erinnerungen neben deinen Terminen anzeigen. Erlaube den Zugriff auf Erinnerungen, um sie hier zu sehen und zu erledigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio can show your reminders next to your events. Allow access to Reminders to see and complete them here."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio peut afficher vos rappels à côté de vos événements. Autorisez l’accès à Rappels pour les consulter et les terminer ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio può mostrare i promemoria accanto agli eventi. Consenti l’accesso a Promemoria per vederli e completarli qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Folioでは、リマインダーを予定と並べて表示できます。ここでリマインダーを表示・完了するには、リマインダーへのアクセスを許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio는 미리 알림을 일정과 나란히 표시할 수 있습니다. 여기에서 미리 알림을 보고 완료하려면 미리 알림 접근을 허용하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio kan je herinneringen naast je afspraken tonen. Sta toegang tot Herinneringen toe om ze hier te bekijken en af te ronden."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio có thể hiển thị lời nhắc bên cạnh sự kiện của bạn. Hãy cho phép truy cập Lời nhắc để xem và hoàn thành chúng tại đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio 可以将提醒事项与日程并排显示。若要在此查看和完成提醒事项，请允许访问“提醒事项”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio 可以將提醒事項與行程並排顯示。若要在此查看和完成提醒事項，請允許取用「提醒事項」。"
          }
        }
      }
    },
