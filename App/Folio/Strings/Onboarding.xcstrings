          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "查看睡眠狀況"
          }
        }
      }
    },
    "Setup.Alerts.Description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio kann dich vor deinen Terminen und bei fälligen Erinnerungen benachrichtigen. Erlaube Mitteilungen, um Hinweise auf diesem Gerät einzuschalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio can alert you before your events and when your reminders are due. Allow notifications to turn alerts on for this device."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio peut vous alerter avant vos événements et à l’échéance de vos rappels. Autorisez les notifications pour activer les alertes sur cet appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio può avvisarti prima degli eventi e alla scadenza dei promemoria. Consenti le notifiche per attivare gli avvisi su questo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Folioは、予定の前やリマインダーの期限に通知できます。このデバイスで通知をオンにするには、通知を許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio는 일정 전과 미리 알림 기한에 알려 드릴 수 있습니다. 이 기기에서 알림을 켜려면 알림을 허용하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio kan je waarschuwen vóór je afspraken en wanneer herinneringen verlopen. Sta meldingen toe om meldingen op dit apparaat in te schakelen."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio có thể thông báo trước sự kiện và khi lời nhắc đến hạn. Hãy cho phép thông báo để bật thông báo trên thiết bị này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio 可以在日程开始前和提醒事项到期时通知你。若要在此设备上开启通知，请允许通知。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio 可以在行程開始前和提醒事項到期時通知你。若要在此裝置上開啟通知，請允許通知。"
          }
        }
      }
    },
