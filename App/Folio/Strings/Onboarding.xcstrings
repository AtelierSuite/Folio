    "Setup.Weather.Description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio kann die Vorhersage in deinem Kalender anzeigen. Erlaube den Zugriff auf die Ortungsdienste, um das Wetter an deinem Standort zu sehen, oder wähle später in den Einstellungen einen Ort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio can show the forecast on your calendar. Allow access to Location Services to see the weather where you are, or choose a place later in Settings."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio peut afficher les prévisions sur votre calendrier. Autorisez l’accès au service de localisation pour voir la météo là où vous êtes, ou choisissez un lieu plus tard dans Réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio può mostrare le previsioni sul calendario. Consenti l’accesso a Localizzazione per vedere il meteo dove ti trovi, oppure scegli un luogo più tardi in Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Folioでは、カレンダーに天気予報を表示できます。現在地の天気を表示するには位置情報サービスへのアクセスを許可してください。場所はあとで設定から選ぶこともできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio는 캘린더에 일기 예보를 표시할 수 있습니다. 현재 위치의 날씨를 보려면 위치 서비스 접근을 허용하거나, 나중에 설정에서 장소를 선택하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio kan de weersverwachting in je agenda tonen. Sta toegang tot Locatievoorzieningen toe om het weer op je locatie te zien, of kies later een plaats in Instellingen."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio có thể hiển thị dự báo trên lịch của bạn. Hãy cho phép truy cập Dịch vụ định vị để xem thời tiết nơi bạn đang ở, hoặc chọn một địa điểm sau trong Cài đặt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio 可以在日历上显示天气预报。若要查看当前位置的天气，请允许访问“定位服务”，也可以稍后在设置中选取地点。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio 可以在行事曆上顯示天氣預報。若要查看目前位置的天氣，請允許取用「定位服務」，也可以稍後在設定中選擇地點。"
          }
        }
      }
    },
