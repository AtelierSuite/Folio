    "Setup.Calendar.Description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio kann die Termine aus deinen Kalendern auf einer Zeitleiste anzeigen. Erlaube den Zugriff auf Kalender, um sie hier zu sehen und zu bearbeiten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio can show the events from your calendars on one timeline. Allow access to Calendars to see and edit them here."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio peut afficher les événements de vos calendriers sur une seule chronologie. Autorisez l’accès à Calendriers pour les consulter et les modifier ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio può mostrare gli eventi dei tuoi calendari in un’unica timeline. Consenti l’accesso a Calendari per vederli e modificarli qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Folioでは、カレンダーの予定を1つのタイムラインに表示できます。ここで予定を表示・編集するには、カレンダーへのアクセスを許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio는 캘린더의 일정을 하나의 타임라인에 표시할 수 있습니다. 여기에서 일정을 보고 편집하려면 캘린더 접근을 허용하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio kan de afspraken uit je agenda’s op één tijdlijn tonen. Sta toegang tot Agenda’s toe om ze hier te bekijken en te wijzigen."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio có thể hiển thị sự kiện từ các lịch của bạn trên một dòng thời gian. Hãy cho phép truy cập Lịch để xem và sửa chúng tại đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio 可以在同一条时间线上显示日历中的日程。若要在此查看和编辑日程，请允许访问“日历”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio 可以在同一條時間列上顯示行事曆中的行程。若要在此查看和編輯行程，請允許取用「行事曆」。"
          }
        }
      }
    },
