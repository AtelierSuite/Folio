    "Denied": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio darf keine Wecker stellen. Erlaube Wecker für Folio in den Einstellungen, um den Weckalarm zu nutzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio isn’t allowed to set alarms. Allow alarms for Folio in Settings to use the wake-up alarm."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio n’est pas autorisé à créer des alarmes. Autorisez les alarmes pour Folio dans Réglages pour utiliser l’alarme de réveil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio non è autorizzato a impostare sveglie. Consenti le sveglie per Folio in Impostazioni per usare la sveglia mattutina."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Folioにはアラームを設定する許可がありません。目覚ましアラームを使うには、設定でFolioのアラームを許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio에 알람 설정 권한이 없습니다. 기상 알람을 사용하려면 설정에서 Folio의 알람을 허용하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio mag geen wekkers zetten. Sta wekkers voor Folio toe in Instellingen om de wekker te gebruiken."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio không được phép đặt báo thức. Hãy cho phép báo thức cho Folio trong Cài đặt để dùng báo thức dậy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio 未获准设置闹钟。请在“设置”中允许 Folio 使用闹钟，以使用起床闹钟。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio 未獲准設定鬧鐘。請在「設定」中允許 Folio 使用鬧鐘，以使用起床鬧鐘。"
          }
        }
      }
    },
