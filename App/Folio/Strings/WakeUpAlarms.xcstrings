    "Earliest": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht vor"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not Before"
          }
        },
        "fr": {
          "stringUnit": {
