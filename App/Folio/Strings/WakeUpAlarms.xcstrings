          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "10 秒后响起下一个闹钟"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "10 秒後響起下一個鬧鐘"
          }
        }
