    },
    "Calendars.Footer": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur Ereignisse in aktivierten Kalendern können den Weckalarm auslösen. Deaktiviere Kalender, die du für Notizen oder Erinnerungen an dich selbst nutzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only events in the calendars that are turned on can set off the wake-up alarm. Turn off calendars you use for notes or reminders to yourself."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls les événements des calendriers activés peuvent déclencher l’alarme de réveil. Désactivez les calendriers qui vous servent de notes ou de pense-bêtes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo gli eventi dei calendari attivati possono far suonare la sveglia. Disattiva i calendari che usi per note o promemoria personali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンにしたカレンダーの予定だけが目覚ましの対象になります。メモや自分用の覚え書きに使っているカレンダーはオフにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "켜져 있는 캘린더의 이벤트만 기상 알람을 울립니다. 메모나 자신을 위한 알림으로 사용하는 캘린더는 끄십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen activiteiten in ingeschakelde agenda's kunnen het wekalarm laten afgaan. Schakel agenda's uit die je gebruikt voor notities of herinneringen aan jezelf."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ sự kiện trong các lịch đang bật mới có thể kích hoạt báo thức. Hãy tắt các lịch bạn dùng để ghi chú hoặc tự nhắc nhở."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有已开启日历中的日程才会触发起床闹钟。请关闭用于记事或自我提醒的日历。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有已開啟行事曆中的活動才會觸發起床鬧鐘。請關閉用於記事或提醒自己的行事曆。"
          }
        }
      }
    },
    "Debug.RingSoon": {
      "extractionState": "manual",
