    "Earliest": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht vor"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not Before"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas avant"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non prima delle"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この時刻より前には鳴らさない"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 시간 이후에만"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niet vóór"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không sớm hơn"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不早于"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不早於"
          }
        }
      }
    },
    "Footer": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klingelt jeden Morgen vor deinem ersten Termin, auch im Stumm-Modus oder in einem Fokus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rings before your first event each morning, even in Silent mode or a Focus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonne avant votre premier évènement chaque matin, même en mode silencieux ou avec un mode de concentration."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Suona ogni mattina prima del tuo primo evento, anche in modalità Silenzioso o Full immersion."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎朝、最初の予定の前に鳴ります。サイレントモードや集中モード中でも鳴ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매일 아침 첫 일정 전에 울립니다. 무음 모드나 집중 모드에서도 울립니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gaat elke ochtend af vóór je eerste afspraak, ook in de stille modus of met een focus."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đổ chuông trước sự kiện đầu tiên mỗi sáng, kể cả khi ở chế độ Im lặng hoặc Tập trung."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每天早上在第一个日程前响铃，静音模式或专注模式下也会响铃。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每天早上在第一個行程前響鈴，靜音模式或專注模式下也會響鈴。"
          }
        }
      }
    },
