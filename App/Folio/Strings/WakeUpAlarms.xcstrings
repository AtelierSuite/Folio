    "Settings.WhenInUse": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Travel time needs location access set to Always."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "移動時間には、位置情報へのアクセスを「常に」にする必要があります。"
