    "Settings.CompressesText" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Text zum Anpassen verkleinern"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compress Text to Fit"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réduire le texte pour l’ajuster"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riduci il testo per adattarlo"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "テキストを縮小して収める"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "텍스트를 줄여서 맞추기"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tekst verkleinen om te passen"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thu nhỏ chữ cho vừa"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "压缩文字以适应"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "壓縮文字以符合"
          }
        }
      }
    },
    "Settings.CompressesText.Footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Text kurzer Termine wird verkleinert, statt abgeschnitten zu werden. Termine, die für Text zu klein sind, werden als farbiger Balken angezeigt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Event text shrinks to fit short events instead of being cut off. Events too small for text show as a colored bar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le texte des évènements courts est réduit pour tenir au lieu d’être tronqué. Les évènements trop petits pour du texte s’affichent sous forme de barre colorée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il testo degli eventi brevi viene ridotto per adattarsi invece di essere troncato. Gli eventi troppo piccoli per il testo appaiono come una barra colorata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "短い予定のテキストを省略せずに縮小して収めます。テキストが入らないほど小さい予定はカラーバーで表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "짧은 이벤트의 텍스트가 잘리지 않고 크기가 줄어들어 맞춰집니다. 텍스트를 표시하기에 너무 작은 이벤트는 색상 막대로 표시됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tekst van korte activiteiten wordt verkleind zodat die past, in plaats van afgekapt. Activiteiten die te klein zijn voor tekst worden als gekleurde balk getoond."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chữ của sự kiện ngắn được thu nhỏ cho vừa thay vì bị cắt. Sự kiện quá nhỏ để hiển thị chữ sẽ hiện dưới dạng thanh màu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "简短日程的文字会缩小以适应，而不会被截断。太小而无法显示文字的日程会显示为彩色条。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "簡短行程的文字會縮小以符合，而不會被截斷。太小而無法顯示文字的行程會顯示為彩色條。"
          }
        }
      }
    },
