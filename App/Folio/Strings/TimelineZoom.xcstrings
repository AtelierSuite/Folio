    "Settings.CompressesText" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Text zum Anpassen verkleinern"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compress Text to Fit"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réduire le texte pour l’ajuster"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riduci il testo per adattarlo"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "テキストを縮小して収める"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "텍스트를 줄여서 맞추기"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tekst verkleinen om te passen"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thu nhỏ chữ cho vừa"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "压缩文字以适应"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "壓縮文字以符合"
          }
        }
      }
    },
    "Settings.CompressesText.Footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Text von Terminen wird in der Tages-, Wochen- und Monatsansicht horizontal gestaucht, statt abgeschnitten zu werden. In der Tages- und Wochenansicht werden Termine, die für Text zu klein sind, als farbiger Balken angezeigt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Event text is squeezed horizontally to fit instead of being cut off, in the day, week and month views. In the day and week views, events too small for text show as a colored bar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le texte des évènements est resserré horizontalement pour tenir au lieu d’être tronqué, dans les vues Jour, Semaine et Mois. Dans les vues Jour et Semaine, les évènements trop petits pour du texte s’affichent sous forme de barre colorée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il testo degli eventi viene compresso orizzontalmente per adattarsi invece di essere troncato, nelle viste Giorno, Settimana e Mese. Nelle viste Giorno e Settimana, gli eventi troppo piccoli per il testo appaiono come una barra colorata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日表示、週表示、月表示で、予定のテキストを省略せずに横方向に縮めて収めます。日表示と週表示では、テキストが入らないほど小さい予定はカラーバーで表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일, 주, 월 보기에서 일정 텍스트가 잘리지 않고 가로로 좁혀져 맞춰집니다. 일 및 주 보기에서 텍스트를 표시하기에 너무 작은 일정은 색상 막대로 표시됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebeurtenistekst wordt in de dag-, week- en maandweergave horizontaal samengedrukt in plaats van afgekapt. In de dag- en weekweergave worden gebeurtenissen die te klein zijn voor tekst als gekleurde balk getoond."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Văn bản sự kiện được nén theo chiều ngang cho vừa thay vì bị cắt bớt, trong chế độ xem ngày, tuần và tháng. Trong chế độ xem ngày và tuần, các sự kiện quá nhỏ để hiển thị văn bản sẽ hiện dưới dạng thanh màu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在日、周和月视图中，日程文字会横向压缩以完整显示，而不会被截断。在日视图和周视图中，太小而无法显示文字的日程会显示为彩色条。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在日、週和月檢視中，行程文字會橫向壓縮以完整顯示，而不會被截斷。在日檢視和週檢視中，太小而無法顯示文字的行程會顯示為彩色條。"
          }
        }
      }
    },
