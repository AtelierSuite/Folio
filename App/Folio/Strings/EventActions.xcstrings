    "Settings.TapBehavior.Footer": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege in beiden Fällen den Finger auf ein Ereignis (oder klicke auf dem Mac bei gedrückter Ctrl-Taste darauf), um die Schnellaktionen zu sehen. Auf dem Mac öffnet ein Doppelklick die Details."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch and hold an event, or Control-click it on a Mac, to see its quick actions either way. On a Mac, double-click an event to open its details."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans les deux cas, maintenez le doigt sur un évènement (ou cliquez dessus en maintenant Contrôle sur un Mac) pour voir ses actions rapides. Sur un Mac, double-cliquez sur un évènement pour ouvrir ses détails."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In entrambi i casi, tieni premuto su un evento (o fai Ctrl-clic su Mac) per vedere le azioni rapide. Su Mac, fai doppio clic su un evento per aprirne i dettagli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どちらの設定でも、イベントを長押し（MacではControlキーを押しながらクリック）するとクイックアクションが表示されます。Macではイベントをダブルクリックすると詳細が開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어느 설정이든 이벤트를 길게 누르거나 Mac에서 Control-클릭하면 빠른 동작이 표시됩니다. Mac에서는 이벤트를 이중 클릭하면 세부사항이 열립니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd in beide gevallen je vinger op een activiteit (of klik met de Control-toets ingedrukt op een Mac) om de snelle acties te zien. Dubbelklik op een Mac op een activiteit om de details te openen."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dù chọn cách nào, hãy chạm và giữ sự kiện (hoặc Control-click trên máy Mac) để xem tác vụ nhanh. Trên máy Mac, bấm đúp vào sự kiện để mở chi tiết."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无论选择哪项，按住日程（在 Mac 上按住 Control 键点按）都可查看快速操作。在 Mac 上，连按日程可打开其详细信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無論選擇哪一項，按住行程（在 Mac 上按住 Control 鍵點按）都可查看快速動作。在 Mac 上，按兩下行程可打開其詳細資訊。"
          }
        }
      }
    },
