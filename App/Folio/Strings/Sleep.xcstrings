{
  "sourceLanguage": "en",
  "strings": {
    "Empty.Description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schlaf, den Apple Watch, iPhone oder andere Apps in der Health-App erfassen, erscheint in deinem Kalender."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep tracked by Apple Watch, iPhone or other apps in the Health app will appear on your calendar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le sommeil suivi par l’Apple Watch, l’iPhone ou d’autres apps dans l’app Santé apparaîtra dans votre calendrier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il sonno registrato da Apple Watch, iPhone o altre app nell’app Salute apparirà nel calendario."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch、iPhone、またはほかのAppでヘルスケアに記録された睡眠がカレンダーに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch, iPhone 또는 다른 앱이 건강 앱에 기록한 수면이 캘린더에 표시됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Slaap die Apple Watch, iPhone of andere apps in de Gezondheid-app vastleggen, verschijnt in je agenda."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giấc ngủ được Apple Watch, iPhone hoặc các ứng dụng khác ghi lại trong ứng dụng Sức khỏe sẽ xuất hiện trên lịch của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch、iPhone 或其他 App 记录在“健康”中的睡眠将显示在你的日历上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch、iPhone 或其他 App 記錄在「健康」中的睡眠將顯示在你的行事曆上。"
          }
        }
      }
    },
    "Empty.Title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch kein Schlaf"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Sleep Yet"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun sommeil pour l’instant"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun dato sul sonno"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "睡眠データはまだありません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 수면 데이터 없음"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog geen slaap"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có dữ liệu giấc ngủ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚无睡眠数据"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚無睡眠資料"
          }
        }
      }
    },
    "Settings.Footer": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schlafdaten stammen aus der Health-App und bleiben auf diesem iPhone. Folio speichert sie nie in iCloud und synchronisiert sie nie mit deinen anderen Geräten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep comes from the Health app and stays on this iPhone. Folio never stores it in iCloud or syncs it to your other devices."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le sommeil provient de l’app Santé et reste sur cet iPhone. Folio ne le stocke jamais dans iCloud et ne le synchronise jamais avec vos autres appareils."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il sonno proviene dall’app Salute e resta su questo iPhone. Folio non lo salva mai su iCloud né lo sincronizza con gli altri dispositivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "睡眠データはヘルスケアから読み込まれ、このiPhoneにのみ保持されます。FolioがiCloudに保存したり、ほかのデバイスと同期したりすることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수면 데이터는 건강 앱에서 가져오며 이 iPhone에만 남아 있습니다. Folio는 수면 데이터를 iCloud에 저장하거나 다른 기기와 동기화하지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Slaap komt uit de Gezondheid-app en blijft op deze iPhone. Folio bewaart deze nooit in iCloud en synchroniseert deze nooit met je andere apparaten."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dữ liệu giấc ngủ lấy từ ứng dụng Sức khỏe và chỉ nằm trên iPhone này. Folio không bao giờ lưu trữ trên iCloud hay đồng bộ sang các thiết bị khác của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "睡眠数据来自“健康”并只保留在这台 iPhone 上。Folio 绝不会将其储存在 iCloud 中或同步到你的其他设备。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "睡眠資料來自「健康」並只保留在這部 iPhone 上。Folio 絕不會將其儲存在 iCloud 中或同步到你的其他裝置。"
          }
        }
      }
    },
