    "Snooze.Footer": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege fest, wie lange die beiden Schlummertasten bei Termin- und Erinnerungshinweisen warten, bevor du erneut benachrichtigt wirst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose how long the two snooze buttons on event and reminder alerts wait before alerting you again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez le délai des deux boutons de rappel différé sur les alertes d’événements et de rappels avant d’être alerté à nouveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli quanto attendono i due pulsanti Posticipa negli avvisi di eventi e promemoria prima di avvisarti di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "イベントとリマインダーの通知にある2つの再通知ボタンで、再び通知するまでの時間を選択します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이벤트 및 미리 알림의 두 가지 다시 알림 버튼이 다시 알려 주기까지 기다리는 시간을 선택합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies hoelang de twee sluimerknoppen bij meldingen voor activiteiten en herinneringen wachten voordat je opnieuw een melding krijgt."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn thời gian chờ của hai nút báo lại trên thông báo sự kiện và lời nhắc trước khi thông báo lại cho bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择日程和提醒事项通知上的两个稍后提醒按钮在再次提醒你之前等待的时长。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇行程和提醒事項通知上的兩個稍後提醒按鈕在再次提醒你之前等待的時間。"
          }
        }
      }
    },
