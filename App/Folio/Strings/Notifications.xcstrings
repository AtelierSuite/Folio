{
  "sourceLanguage": "en",
  "strings": {
    "About.AlertTimes": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio erinnert dich zu den Hinweiszeiten, die bei jedem Ereignis und jeder Erinnerung eingestellt sind. Kalender und Erinnerungen senden zu denselben Zeiten eigene Hinweise. Deaktiviere daher ihre Mitteilungen in den Einstellungen, um jeden Hinweis nur einmal zu erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio alerts you at the alert times set on each event and reminder. Calendar and Reminders send their own alerts at the same times, so turn off notifications for Calendar and Reminders in Settings to get each alert only once."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio vous prévient aux heures d’alerte définies sur chaque événement et rappel. Calendrier et Rappels envoient leurs propres alertes aux mêmes heures : désactivez leurs notifications dans Réglages pour ne recevoir chaque alerte qu’une seule fois."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio ti avvisa agli orari di avviso impostati su ogni evento e promemoria. Calendario e Promemoria inviano i propri avvisi agli stessi orari, quindi disattiva le loro notifiche in Impostazioni per ricevere ogni avviso una sola volta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Folioは、各イベントとリマインダーに設定された通知時刻にお知らせします。カレンダーとリマインダーも同じ時刻に独自の通知を送るため、各通知を1回だけ受け取るには「設定」でカレンダーとリマインダーの通知をオフにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio는 각 이벤트와 미리 알림에 설정된 알림 시간에 알려 줍니다. 캘린더와 미리 알림도 같은 시간에 자체 알림을 보내므로, 각 알림을 한 번만 받으려면 설정에서 캘린더와 미리 알림의 알림을 끄세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio waarschuwt je op de meldingstijden die bij elke activiteit en herinnering zijn ingesteld. Agenda en Herinneringen sturen op dezelfde tijden hun eigen meldingen, dus zet hun meldingen uit in Instellingen om elke melding maar één keer te krijgen."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio cảnh báo bạn vào thời điểm cảnh báo được đặt trên mỗi sự kiện và lời nhắc. Lịch và Lời nhắc cũng gửi cảnh báo riêng vào cùng thời điểm, vì vậy hãy tắt thông báo của Lịch và Lời nhắc trong Cài đặt để chỉ nhận mỗi cảnh báo một lần."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio 会在每个日程和提醒事项设定的提醒时间通知你。“日历”和“提醒事项”也会在相同时间发送各自的提醒，因此请在“设置”中关闭“日历”和“提醒事项”的通知，这样每个提醒只会收到一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio 會在每個行程和提醒事項設定的提醒時間通知你。「行事曆」和「提醒事項」也會在相同時間傳送各自的提醒，因此請在「設定」中關閉「行事曆」和「提醒事項」的通知，這樣每個提醒只會收到一次。"
          }
        }
      }
    },
    "About.Limit": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio plant deine nächsten Hinweise ein und fügt spätere bei jeder Aktualisierung hinzu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio keeps your soonest alerts scheduled and adds later ones each time it refreshes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio programme vos alertes les plus proches et ajoute les suivantes à chaque actualisation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio programma gli avvisi più vicini e aggiunge quelli successivi a ogni aggiornamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Folioは直近の通知を予定に入れておき、更新するたびに以降の通知を追加します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio는 가장 가까운 알림을 예약해 두고, 새로 고칠 때마다 이후 알림을 추가합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio plant je eerstvolgende meldingen in en voegt latere toe bij elke vernieuwing."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio lên lịch các cảnh báo gần nhất và thêm các cảnh báo sau mỗi lần làm mới."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio 会安排最近的提醒，并在每次刷新时添加之后的提醒。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio 會排定最近的提醒，並在每次重新整理時加入之後的提醒。"
          }
        }
      }
    },
    "About.Section": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "So funktionieren Hinweise"
          }
        },
