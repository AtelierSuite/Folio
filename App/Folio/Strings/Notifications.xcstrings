    "KeepAlerts.Footer": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geöffnete Hinweise bleiben bis zum Ende des Termins in der Mitteilungszentrale. Geschlummerte oder gelöschte Hinweise werden entfernt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opened alerts stay in Notification Center until the event ends. Snoozed or cleared alerts are removed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les alertes ouvertes restent dans le centre de notifications jusqu’à la fin de l’événement. Les alertes différées ou effacées sont supprimées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli avvisi aperti restano nel Centro Notifiche fino al termine dell’evento. Gli avvisi posticipati o cancellati vengono rimossi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開いた通知をイベント終了まで通知センターに残します。スヌーズまたは消去した通知は削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연 알림은 이벤트가 끝날 때까지 알림 센터에 유지됩니다. 다시 알림으로 미루거나 지운 알림은 삭제됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geopende meldingen blijven in het berichtencentrum tot het evenement afloopt. Gesluimerde of gewiste meldingen worden verwijderd."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thông báo đã mở được giữ trong Trung tâm thông báo cho đến khi sự kiện kết thúc. Thông báo đã báo lại hoặc đã xóa sẽ bị gỡ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开过的提醒会保留在通知中心，直到日程结束。延后或清除的提醒会被移除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打開過的提醒會保留在通知中心，直到行程結束。延後或清除的提醒會被移除。"
          }
        }
      }
    },
