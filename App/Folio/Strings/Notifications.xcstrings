    "Enabled": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinweise auf diesem Gerät"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alerts on This Device"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alertes sur cet appareil"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvisi su questo dispositivo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスで通知"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에서 알림"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldingen op dit apparaat"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cảnh báo trên thiết bị này"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在此设备上提醒"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在此裝置上提醒"
          }
        }
      }
    },
    "Enabled.Footer": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes iPhone, iPad und jeder Mac hat eine eigene Einstellung. Aktiviere Hinweise nur auf den Geräten, die dich erinnern sollen, damit nicht überall derselbe Hinweis erscheint."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each iPhone, iPad and Mac has its own setting. Turn alerts on only on the devices you want to hear from, so the same alert doesn’t go off everywhere."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque iPhone, iPad et Mac a son propre réglage. N’activez les alertes que sur les appareils qui doivent vous prévenir, pour que la même alerte ne sonne pas partout."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni iPhone, iPad e Mac ha la propria impostazione. Attiva gli avvisi solo sui dispositivi da cui vuoi riceverli, così lo stesso avviso non suona ovunque."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone、iPad、Macはそれぞれ個別に設定します。同じ通知がすべてのデバイスで鳴らないように、通知を受け取りたいデバイスでのみオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone, iPad, Mac마다 설정이 따로 있습니다. 같은 알림이 모든 기기에서 울리지 않도록 알림을 받고 싶은 기기에서만 켜세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke iPhone, iPad en Mac heeft een eigen instelling. Zet meldingen alleen aan op de apparaten waarop je ze wilt krijgen, zodat dezelfde melding niet overal afgaat."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi iPhone, iPad và Mac có cài đặt riêng. Chỉ bật cảnh báo trên các thiết bị bạn muốn nhận, để cùng một cảnh báo không reo trên mọi thiết bị."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每台 iPhone、iPad 和 Mac 都有各自的设置。仅在想接收提醒的设备上打开，以免同一提醒在所有设备上响起。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每部 iPhone、iPad 和 Mac 都有各自的設定。只在想接收提醒的裝置上開啟，以免同一提醒在所有裝置上響起。"
          }
        }
      }
    },
