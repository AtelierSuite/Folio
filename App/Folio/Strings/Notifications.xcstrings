          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zo werken meldingen"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cách cảnh báo hoạt động"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提醒的工作方式"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "提醒的運作方式"
          }
        }
      }
    },
    "About.Stale": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn ein Ereignis auf einem anderen Gerät geändert wird, kann ein auf diesem Gerät bereits geplanter Hinweis noch zur alten Zeit erscheinen, bis Folio geöffnet oder im Hintergrund aktualisiert wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If an event changes on another device, an alert already scheduled on this device can still go off at the old time until Folio opens or refreshes in the background."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si un événement est modifié sur un autre appareil, une alerte déjà programmée sur cet appareil peut encore sonner à l’ancienne heure jusqu’à ce que Folio s’ouvre ou s’actualise en arrière-plan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se un evento cambia su un altro dispositivo, un avviso già programmato su questo dispositivo può suonare ancora all’orario precedente finché Folio non si apre o si aggiorna in background."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のデバイスでイベントが変更された場合、Folioが開かれるかバックグラウンドで更新されるまで、このデバイスで予定済みの通知が元の時刻に届くことがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 기기에서 이벤트가 변경되면, Folio가 열리거나 백그라운드에서 새로 고쳐질 때까지 이 기기에 이미 예약된 알림이 이전 시간에 울릴 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als een activiteit op een ander apparaat verandert, kan een melding die al op dit apparaat gepland staat nog op de oude tijd afgaan totdat Folio opent of op de achtergrond vernieuwt."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu một sự kiện thay đổi trên thiết bị khác, cảnh báo đã lên lịch trên thiết bị này vẫn có thể reo vào giờ cũ cho đến khi Folio được mở hoặc làm mới trong nền."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果日程在其他设备上被更改，在 Folio 打开或在后台刷新之前，此设备上已安排的提醒仍可能在原来的时间响起。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果行程在其他裝置上被更改，在 Folio 開啟或在背景重新整理之前，此裝置上已排定的提醒仍可能在原本的時間響起。"
          }
        }
      }
    },
    "Denied": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitteilungen für Folio sind in den Einstellungen deaktiviert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications for Folio are turned off in Settings."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications de Folio sont désactivées dans Réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le notifiche di Folio sono disattivate in Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Folioの通知は「設定」でオフになっています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio의 알림이 설정에서 꺼져 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldingen voor Folio staan uit in Instellingen."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thông báo của Folio đang tắt trong Cài đặt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio 的通知已在“设置”中关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio 的通知已在「設定」中關閉。"
          }
        }
      }
    },
