    "Editor.NoCalendars.Description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow full access to calendars, or add a calendar you can edit, to create events."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予定を作成するには、カレンダーへのフルアクセスを許可するか、編集可能なカレンダーを追加してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要创建日程，请允许完全访问日历，或添加一个可编辑的日历。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "若要建立行程，請允許完整取用行事曆，或加入可編輯的行事曆。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이벤트를 생성하려면 캘린더에 대한 전체 접근을 허용하거나 편집 가능한 캘린더를 추가하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour créer des événements, autorisez l’accès complet aux calendriers ou ajoutez un calendrier modifiable."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube vollen Zugriff auf Kalender oder füge einen bearbeitbaren Kalender hinzu, um Termine zu erstellen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per creare eventi, consenti l’accesso completo ai calendari o aggiungi un calendario modificabile."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sta volledige toegang tot agenda’s toe of voeg een bewerkbare agenda toe om events aan te maken."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để tạo sự kiện, hãy cho phép truy cập đầy đủ vào lịch hoặc thêm một lịch có thể sửa."
          }
        }
      }
    },
