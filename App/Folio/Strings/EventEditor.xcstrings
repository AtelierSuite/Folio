    "Detail.ReadOnly.Calendar": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This event is in a read-only calendar and can’t be changed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この予定は読み出し専用のカレンダーにあるため変更できません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此日程位于只读日历中，无法更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此行程位於唯讀行事曆中，無法更改。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 이벤트는 읽기 전용 캘린더에 있어 변경할 수 없습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet événement se trouve dans un calendrier en lecture seule et ne peut pas être modifié."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Termin befindet sich in einem schreibgeschützten Kalender und kann nicht geändert werden."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo evento si trova in un calendario di sola lettura e non può essere modificato."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit event staat in een alleen-lezen agenda en kan niet worden gewijzigd."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sự kiện này nằm trong lịch chỉ đọc và không thể thay đổi."
          }
        }
      }
    },
    "Detail.ReadOnly.Invitation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
