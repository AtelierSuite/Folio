    "Alerts.Footer": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geburtstage ohne eigene Hinweise werden zur für den Kalender festgelegten Uhrzeit gemeldet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Birthdays without alerts of their own alert at the time set for the calendar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les anniversaires sans alerte propre sont signalés à l’heure définie pour le calendrier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I compleanni senza avvisi propri vengono notificati all’ora impostata per il calendario."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "独自の通知がない誕生日は、カレンダーに設定した時刻に通知されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자체 알림이 없는 생일은 캘린더에 설정한 시간에 알림을 받습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verjaardagen zonder eigen meldingen worden gemeld op het tijdstip dat voor de agenda is ingesteld."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinh nhật không có cảnh báo riêng sẽ cảnh báo vào giờ đã đặt cho lịch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有设置提醒的生日会在为该日历设置的时间提醒。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有設定提醒的生日會在為該行事曆設定的時間提醒。"
          }
        }
      }
    },
