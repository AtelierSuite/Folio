    "Contact.NotShared": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio kann diesen Kontakt nicht sehen. Du kannst ihn in den Einstellungen für Folio freigeben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio can't see this contact. You can share it with Folio in Settings."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio ne peut pas voir ce contact. Vous pouvez le partager avec Folio dans Réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio non può vedere questo contatto. Puoi condividerlo con Folio in Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Folioはこの連絡先を参照できません。設定でFolioと共有できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio에서 이 연락처를 볼 수 없습니다. 설정에서 Folio와 공유할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio kan dit contact niet zien. Je kunt het in Instellingen met Folio delen."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio không thể xem liên hệ này. Bạn có thể chia sẻ liên hệ với Folio trong Cài đặt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio 无法查看此联系人。你可以在“设置”中与 Folio 共享。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio 無法查看此聯絡人。你可以在「設定」中與 Folio 共享。"
          }
        }
      }
    },
