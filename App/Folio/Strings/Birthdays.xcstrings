    "Calendars.Footer": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ereignisse in diesen Kalendern werden wie der Geburtstagskalender als Geburtstage angezeigt und gemeldet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Events in these calendars are shown and alerted as birthdays, like the Birthdays calendar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les événements de ces calendriers sont affichés et signalés comme des anniversaires, comme le calendrier Anniversaires."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli eventi di questi calendari vengono mostrati e notificati come compleanni, come il calendario Compleanni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらのカレンダーのイベントは、誕生日カレンダーと同じように誕生日として表示・通知されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 캘린더의 이벤트는 생일 캘린더처럼 생일로 표시되고 알림을 받습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Activiteiten in deze agenda’s worden net als de verjaardagsagenda als verjaardagen getoond en gemeld."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sự kiện trong các lịch này được hiển thị và cảnh báo như sinh nhật, giống lịch Sinh nhật."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些日历中的日程会像生日日历一样作为生日显示和提醒。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些行事曆中的行程會像生日行事曆一樣以生日顯示和提醒。"
          }
        }
      }
    },
