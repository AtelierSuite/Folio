    "Settings.Unavailable": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät kann keine Ankünfte erkennen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device can't detect arrivals."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil ne peut pas détecter les arrivées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo dispositivo non può rilevare gli arrivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスは到着を検知できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기는 도착을 감지할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit apparaat kan aankomsten niet detecteren."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thiết bị này không thể phát hiện việc đến nơi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备无法检测到达。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此裝置無法偵測抵達。"
          }
        }
      }
    },
    "Settings.WhenInUse": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrival alerts need location access set to Always."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "到着通知には、位置情報へのアクセスを「常に」にする必要があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "到达提醒需要将位置访问设为“始终”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "抵達提醒需要將位置取用權設為「永遠」。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "도착 알림을 사용하려면 위치 접근을 '항상'으로 설정해야 합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les alertes d’arrivée nécessitent l’accès à la position Toujours."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ankunftsmitteilungen brauchen den Standortzugriff „Immer“."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli avvisi di arrivo richiedono l’accesso alla posizione Sempre."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aankomstmeldingen hebben locatietoegang Altijd nodig."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thông báo khi đến nơi cần quyền truy cập vị trí Luôn luôn."
          }
        }
      }
    },
    "Unsupported": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ankunftshinweise funktionieren auf dem iPhone."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrival alerts work on iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les alertes d'arrivée fonctionnent sur iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli avvisi di arrivo funzionano su iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "到着通知はiPhoneで利用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "도착 알림은 iPhone에서 작동합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aankomstmeldingen werken op de iPhone."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cảnh báo khi đến nơi hoạt động trên iPhone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "到达提醒适用于 iPhone。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "抵達提醒適用於 iPhone。"
          }
        }
      }
    }
  },
