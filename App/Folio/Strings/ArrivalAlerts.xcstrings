{
  "sourceLanguage": "en",
  "strings": {
    "Editor.Footer": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erhalte einen Hinweis, wenn du ab 2 Stunden vor Beginn an diesem Ort ankommst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get an alert when you arrive at this location, from 2 hours before the event starts."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recevez une alerte quand vous arrivez à ce lieu, dès 2 heures avant le début de l'événement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricevi un avviso quando arrivi in questo luogo, da 2 ore prima dell'inizio dell'evento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "イベント開始2時間前から、この場所に到着したときに通知します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이벤트 시작 2시간 전부터 이 장소에 도착하면 알려 줍니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Krijg een melding als je vanaf 2 uur voor de start op deze locatie aankomt."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhận cảnh báo khi bạn đến địa điểm này, từ 2 giờ trước khi sự kiện bắt đầu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从活动开始前 2 小时起，到达此地点时提醒你。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從活動開始前 2 小時起，抵達此地點時提醒你。"
          }
        }
      }
    },
    "Editor.NoLocation": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge einen Ort hinzu, um bei Ankunft einen Hinweis zu erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a location to get an alert when you arrive."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez un lieu pour recevoir une alerte à votre arrivée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi un luogo per ricevere un avviso all'arrivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "到着時に通知を受け取るには、場所を追加してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "도착 시 알림을 받으려면 위치를 추가하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg een locatie toe om een melding te krijgen als je aankomt."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm địa điểm để nhận cảnh báo khi bạn đến nơi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加地点即可在到达时收到提醒。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "加入地點即可在抵達時收到提醒。"
          }
        }
      }
    },
    "Editor.Toggle": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei Ankunft benachrichtigen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notify on Arrival"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "M'avertir à l'arrivée"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvisami all'arrivo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "到着時に通知"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "도착 시 알림"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Melden bij aankomst"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thông báo khi đến nơi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "到达时通知"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "抵達時通知"
          }
        }
      }
    },
    "Editor.TurnedOff": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere in den Einstellungen Mitteilungen und Ankunftshinweise, um diesen Hinweis zu erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on Notifications and Arrival Alerts in Settings to get this alert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez les notifications et les alertes d'arrivée dans les réglages pour recevoir cette alerte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva le notifiche e gli avvisi di arrivo nelle impostazioni per ricevere questo avviso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この通知を受け取るには、設定で「通知」と「到着通知」をオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 알림을 받으려면 설정에서 알림과 도착 알림을 켜세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet meldingen en aankomstmeldingen aan in de instellingen om deze melding te krijgen."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật Thông báo và Cảnh báo khi đến nơi trong Cài đặt để nhận cảnh báo này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“设置”中打开“通知”和“到达提醒”以接收此提醒。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在「設定」中開啟「通知」和「抵達提醒」以接收此提醒。"
          }
        }
      }
    },
    "Settings.Footer": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erinnert dich, wenn du am Ort eines Termins ankommst. Für jeden Termin einzeln aktivieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alerts you when you arrive at an event. Turn it on for each event."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous alerte à votre arrivée sur le lieu d’un évènement. Activez-le pour chaque évènement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti avvisa quando arrivi al luogo di un evento. Attivalo per ogni evento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予定の場所に着くと通知します。予定ごとにオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일정 장소에 도착하면 알려 줍니다. 일정마다 켜십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Waarschuwt je wanneer je bij een afspraak aankomt. Zet het per afspraak aan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Báo khi bạn đến địa điểm sự kiện. Bật cho từng sự kiện."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "到达日程地点时提醒你。请为每个日程单独打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "抵達行程地點時提醒你。請為每個行程個別開啟。"
          }
        }
      }
    },
