    "Settings.Footer %@" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügt der Tages-, Mehrtages- und Wochenansicht eine Stundenspalte für diese Zeitzone hinzu. Alles andere, auch neue Termine, verwendet die Systemzeitzone (%@)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adds an hour column for this time zone to the day, multi-day and week views. Everything else, including new events, uses the system time zone (%@)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoute une colonne d’heures pour ce fuseau horaire aux vues jour, plusieurs jours et semaine. Tout le reste, y compris les nouveaux événements, utilise le fuseau horaire du système (%@)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiunge una colonna delle ore per questo fuso orario alle viste giorno, più giorni e settimana. Tutto il resto, compresi i nuovi eventi, usa il fuso orario di sistema (%@)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日、複数日、週表示にこの時間帯の時刻列を追加します。新規イベントを含むその他すべては、システムの時間帯（%@）を使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일, 다중 일 및 주 보기에 이 시간대의 시간 열을 추가합니다. 새 이벤트를 포함한 나머지는 모두 시스템 시간대(%@)를 사용합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voegt een urenkolom voor deze tijdzone toe aan de dag-, meerdaagse en weekweergave. Al het andere, ook nieuwe activiteiten, gebruikt de systeemtijdzone (%@)."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thêm một cột giờ cho múi giờ này vào chế độ xem ngày, nhiều ngày và tuần. Mọi thứ khác, kể cả sự kiện mới, đều dùng múi giờ hệ thống (%@)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在日、多日和周视图中添加此时区的小时列。其他所有内容（包括新日程）均使用系统时区（%@）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在日、多日和週視圖中加入此時區的小時欄。其他所有內容（包括新行程）均使用系統時區（%@）。"
          }
        }
      }
    },
