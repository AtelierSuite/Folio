{
  "sourceLanguage": "en",
  "strings": {
    "Access.Allow": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zugriff erlauben"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Access"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autoriser l’accès"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti accesso"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセスを許可"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "접근 허용"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sta toegang toe"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho phép truy cập"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许访问"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許取用"
          }
        }
      }
    },
    "Access.Description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube Folio den Zugriff auf deine Kalender und Erinnerungen, um sie hier zu sehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Folio to access your calendars and reminders to see them here."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez Folio à accéder à vos calendriers et rappels pour les voir ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti a Folio di accedere ai calendari e ai promemoria per vederli qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここに表示するには、Folioにカレンダーとリマインダーへのアクセスを許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기에서 보려면 Folio가 캘린더와 미리 알림에 접근하도록 허용하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geef Folio toegang tot je agenda's en herinneringen om ze hier te zien."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho phép Folio truy cập lịch và lời nhắc của bạn để xem chúng tại đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许 Folio 访问你的日历和提醒事项，即可在这里查看。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許 Folio 取用你的行事曆和提醒事項，即可在這裡檢視。"
          }
        }
      }
    },
    "Access.Title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalenderzugriff erforderlich"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendar Access Needed"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accès au calendrier requis"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accesso al calendario necessario"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カレンダーへのアクセスが必要です"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캘린더 접근 권한 필요"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toegang tot agenda vereist"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cần quyền truy cập lịch"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要访问日历"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要取用行事曆"
          }
        }
      }
    },
    "Empty.Description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Termine und Erinnerungen aus deinen sichtbaren Kalendern und Listen werden hier angezeigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Events and reminders from your visible calendars and lists will appear here."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les évènements et rappels de vos calendriers et listes visibles s’afficheront ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli eventi e i promemoria dei calendari e degli elenchi visibili verranno mostrati qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表示中のカレンダーとリストの予定とリマインダーがここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "표시 중인 캘린더와 목록의 일정 및 미리 알림이 여기에 표시됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Afspraken en herinneringen uit je zichtbare agenda's en lijsten worden hier weergegeven."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sự kiện và lời nhắc từ các lịch và danh sách đang hiển thị sẽ xuất hiện ở đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可见日历和列表中的日程与提醒事项将显示在这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可見行事曆和列表中的活動與提醒事項將顯示在這裡。"
          }
        }
      }
    },
    "Empty.Title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
