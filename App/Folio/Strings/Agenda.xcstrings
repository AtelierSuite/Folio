          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niets in de komende 7 dagen"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có gì trong 7 ngày tới"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未来 7 天没有安排"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未來 7 天沒有安排"
          }
        }
      }
    },
