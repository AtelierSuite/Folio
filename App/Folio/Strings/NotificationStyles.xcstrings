    "Defaults.Empty": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Kalender oder Erinnerungslisten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No calendars or reminder lists."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun calendrier ni liste de rappels."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun calendario o elenco promemoria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カレンダーやリマインダーリストがありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캘린더나 미리 알림 목록이 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen agenda’s of herinneringslijsten."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có lịch hoặc danh sách lời nhắc."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有日历或提醒事项列表。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有行事曆或提醒事項列表。"
          }
        }
      }
    },
    "Defaults.Footer": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege fest, wie Hinweise aus jedem Kalender und jeder Liste ankommen. Den Stil eines einzelnen Ereignisses oder einer Erinnerung kannst du im Editor ändern. Dringliche Hinweise durchbrechen einen Fokus, wenn du es erlaubst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose how alerts from each calendar and list arrive. You can change the style of a single event or reminder in its editor. Time Sensitive alerts break through Focus where you allow it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez comment arrivent les alertes de chaque calendrier et liste. Vous pouvez modifier le style d’un événement ou d’un rappel dans son éditeur. Les alertes urgentes passent outre les concentrations lorsque vous l’autorisez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli come arrivano gli avvisi di ogni calendario ed elenco. Puoi modificare lo stile di un singolo evento o promemoria nel relativo editor. Gli avvisi urgenti superano le full immersion dove lo consenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カレンダーやリストごとに通知の届き方を選べます。個別のイベントやリマインダーのスタイルは編集画面で変更できます。時間確定通知は、許可している集中モードでも届きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 캘린더와 목록의 알림이 전달되는 방식을 선택합니다. 개별 이벤트나 미리 알림의 스타일은 편집기에서 변경할 수 있습니다. 시간 민감 알림은 허용한 집중 모드에서도 전달됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies hoe meldingen van elke agenda en lijst binnenkomen. Je kunt de stijl van een afzonderlijke activiteit of herinnering in de editor wijzigen. Tijdgevoelige meldingen komen door een focus heen als je dat toestaat."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn cách cảnh báo từ mỗi lịch và danh sách được gửi đến. Bạn có thể thay đổi kiểu của từng sự kiện hoặc lời nhắc trong trình chỉnh sửa. Cảnh báo nhạy cảm thời gian vượt qua chế độ Tập trung khi bạn cho phép."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择每个日历和列表的提醒送达方式。你可以在编辑器中更改单个日程或提醒事项的样式。在你允许的情况下，时效性提醒可突破专注模式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇每個行事曆和列表的提醒送達方式。你可以在編輯器中更改單一行程或提醒事項的樣式。在你允許的情況下，時效性提醒可突破專注模式。"
          }
        }
      }
    },
    "Defaults.Footer.Alarms": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege fest, wie Hinweise aus jedem Kalender und jeder Liste ankommen. Den Stil eines einzelnen Ereignisses oder einer Erinnerung kannst du im Editor ändern. Dringliche Hinweise durchbrechen einen Fokus, wenn du es erlaubst. Wecker klingeln auch im Stummmodus und im Fokus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose how alerts from each calendar and list arrive. You can change the style of a single event or reminder in its editor. Time Sensitive alerts break through Focus where you allow it. Alarms ring even in Silent mode and Focus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez comment arrivent les alertes de chaque calendrier et liste. Vous pouvez modifier le style d’un événement ou d’un rappel dans son éditeur. Les alertes urgentes passent outre les concentrations lorsque vous l’autorisez. Les alarmes sonnent même en mode silencieux et avec une concentration."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli come arrivano gli avvisi di ogni calendario ed elenco. Puoi modificare lo stile di un singolo evento o promemoria nel relativo editor. Gli avvisi urgenti superano le full immersion dove lo consenti. Le sveglie suonano anche in modalità silenziosa e con una full immersion."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カレンダーやリストごとに通知の届き方を選べます。個別のイベントやリマインダーのスタイルは編集画面で変更できます。時間確定通知は、許可している集中モードでも届きます。アラームは消音モードや集中モード中でも鳴ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 캘린더와 목록의 알림이 전달되는 방식을 선택합니다. 개별 이벤트나 미리 알림의 스타일은 편집기에서 변경할 수 있습니다. 시간 민감 알림은 허용한 집중 모드에서도 전달됩니다. 알람은 무음 모드와 집중 모드에서도 울립니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies hoe meldingen van elke agenda en lijst binnenkomen. Je kunt de stijl van een afzonderlijke activiteit of herinnering in de editor wijzigen. Tijdgevoelige meldingen komen door een focus heen als je dat toestaat. Wekkers gaan ook af in de stille modus en tijdens een focus."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn cách cảnh báo từ mỗi lịch và danh sách được gửi đến. Bạn có thể thay đổi kiểu của từng sự kiện hoặc lời nhắc trong trình chỉnh sửa. Cảnh báo nhạy cảm thời gian vượt qua chế độ Tập trung khi bạn cho phép. Báo thức vẫn đổ chuông ở chế độ im lặng và khi bật Tập trung."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择每个日历和列表的提醒送达方式。你可以在编辑器中更改单个日程或提醒事项的样式。在你允许的情况下，时效性提醒可突破专注模式。闹钟在静音模式和专注模式下也会响起。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇每個行事曆和列表的提醒送達方式。你可以在編輯器中更改單一行程或提醒事項的樣式。在你允許的情況下，時效性提醒可突破專注模式。鬧鐘在靜音模式和專注模式下也會響起。"
          }
        }
      }
    },
