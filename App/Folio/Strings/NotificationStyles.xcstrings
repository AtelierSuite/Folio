{
  "sourceLanguage": "en",
  "strings": {
    "AlarmDenied": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio darf keine Wecker stellen. Hinweise im Stil „Wecker“ kommen daher als dringliche Mitteilungen an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio isn’t allowed to set alarms, so Alarm-style alerts arrive as Time Sensitive notifications instead."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio n’est pas autorisé à créer des alarmes : les alertes de style Alarme arrivent donc sous forme de notifications urgentes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio non è autorizzato a impostare sveglie, quindi gli avvisi con stile Sveglia arrivano come notifiche urgenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Folioにアラームの設定が許可されていないため、アラームスタイルの通知は時間確定通知として届きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio에 알람 설정 권한이 없으므로 알람 스타일의 알림은 시간 민감 알림으로 전달됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio mag geen wekkers instellen, dus meldingen met de stijl Wekker komen binnen als tijdgevoelige meldingen."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio không được phép đặt báo thức, vì vậy cảnh báo kiểu Báo thức sẽ được gửi dưới dạng thông báo nhạy cảm thời gian."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio 未获准设置闹钟，因此“闹钟”样式的提醒将改为以时效性通知送达。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio 未獲准設定鬧鐘，因此「鬧鐘」樣式的提醒將改以時效性通知送達。"
          }
        }
      }
    },
