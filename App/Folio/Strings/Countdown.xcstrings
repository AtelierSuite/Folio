{
  "sourceLanguage": "en",
  "strings": {
    "Countdown.AvailableLater": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verfügbar 8 Stunden vor Beginn"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Available 8 hours before start"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Disponible 8 heures avant le début"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disponibile 8 ore prima dell'inizio"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開始の8時間前から利用できます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시작 8시간 전부터 사용 가능"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beschikbaar 8 uur voor de start"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khả dụng 8 giờ trước khi bắt đầu"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始前 8 小时内可用"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開始前 8 小時內可用"
          }
        }
      }
    },
    "Countdown.Start": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Countdown starten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start Countdown"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Démarrer le compte à rebours"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvia conto alla rovescia"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カウントダウンを開始"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카운트다운 시작"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Start aftellen"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bắt đầu đếm ngược"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始倒计时"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開始倒數計時"
          }
        }
      }
    },
    "Countdown.StartFailed": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Countdown konnte nicht gestartet werden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't Start Countdown"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de démarrer le compte à rebours"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile avviare il conto alla rovescia"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カウントダウンを開始できませんでした"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카운트다운을 시작할 수 없음"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan aftellen niet starten"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể bắt đầu đếm ngược"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法开始倒计时"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法開始倒數計時"
          }
        }
      }
    },
    "Countdown.Stop": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Countdown beenden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop Countdown"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrêter le compte à rebours"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Interrompi conto alla rovescia"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カウントダウンを停止"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카운트다운 중단"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop aftellen"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dừng đếm ngược"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停止倒计时"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "停止倒數計時"
          }
        }
      }
    },
    "Countdown.TurnedOff": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Live-Aktivitäten sind für Folio möglicherweise deaktiviert. Du kannst sie in den Einstellungen aktivieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Live Activities may be turned off for Folio. You can turn them on in Settings."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les activités en direct sont peut-être désactivées pour Folio. Vous pouvez les activer dans Réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le attività in tempo reale potrebbero essere disattivate per Folio. Puoi attivarle in Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Folioのライブアクティビティがオフになっている可能性があります。「設定」でオンにできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio의 실시간 현황이 꺼져 있을 수 있습니다. 설정에서 켤 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Live Activities staan mogelijk uit voor Folio. Je kunt ze aanzetten in Instellingen."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoạt động trực tiếp có thể đã bị tắt cho Folio. Bạn có thể bật trong Cài đặt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio 的实时活动可能已关闭。你可以在“设置”中打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio 的即時動態可能已關閉。你可以在「設定」中開啟。"
          }
        }
      }
    },
    "OK": {
      "extractionState": "manual",
      "localizations": {
        "de": {
