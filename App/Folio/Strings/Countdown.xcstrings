    "Countdown.AvailableLater": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verfügbar 8 Stunden vor Beginn"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Available 8 hours before start"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Disponible 8 heures avant le début"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disponibile 8 ore prima dell'inizio"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開始の8時間前から利用できます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시작 8시간 전부터 사용 가능"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beschikbaar 8 uur voor de start"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khả dụng 8 giờ trước khi bắt đầu"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始前 8 小时内可用"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開始前 8 小時內可用"
          }
        }
      }
    },
