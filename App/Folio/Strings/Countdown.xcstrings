    "StartCountdownIntent.Unavailable": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Countdowns sind auf diesem Gerät nicht verfügbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Countdowns aren't available on this device."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les comptes à rebours ne sont pas disponibles sur cet appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il conto alla rovescia non è disponibile su questo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスではカウントダウンを利用できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에서는 카운트다운을 사용할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aftellen is niet beschikbaar op dit apparaat."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tính năng đếm ngược không khả dụng trên thiết bị này."
          }
        },
        "zh-Hans": {
