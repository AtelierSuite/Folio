    "Settings.Phases.Footer": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn nur „Zeit bis zum Ende“ aktiv ist, zeigt der Countdown ab dem Start die Zeit bis zum Ende des Ereignisses. Mindestens eine Option muss aktiv bleiben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With only Time to End on, a countdown shows the time to the end of the event from the moment you start it. At least one must stay on."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si seul « Temps avant la fin » est activé, le compte à rebours indique le temps restant avant la fin de l'événement dès son lancement. Au moins une option doit rester activée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con solo \"Tempo alla fine\" attivo, il conto alla rovescia mostra il tempo che manca alla fine dell'evento dal momento in cui lo avvii. Almeno un'opzione deve restare attiva."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「終了までの時間」のみをオンにすると、開始した時点からイベント終了までの時間を表示します。少なくとも1つはオンにする必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'종료까지 남은 시간'만 켜면 카운트다운을 시작한 순간부터 이벤트 종료까지 남은 시간을 표시합니다. 하나 이상은 켜 두어야 합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als alleen 'Tijd tot einde' aan staat, toont de aftelling vanaf het starten de tijd tot het einde van de gebeurtenis. Er moet er minstens één aan blijven."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi chỉ bật \"Thời gian đến khi kết thúc\", đếm ngược sẽ hiển thị thời gian đến khi sự kiện kết thúc ngay từ lúc bạn bắt đầu. Phải bật ít nhất một mục."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果只打开“距结束时间”，倒计时从启动时起就会显示距日程结束的时间。至少需要打开一项。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果只開啟「距結束時間」，倒數計時從啟動時起就會顯示距行程結束的時間。至少需要開啟一項。"
          }
        }
      }
    },
