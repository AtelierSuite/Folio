        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "OK"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확인"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "OK"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "OK"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "好"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "好"
          }
        }
      }
    },
    "StartCountdownIntent.Description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zählt auf dem Sperrbildschirm und in der Dynamic Island bis zu deinem nächsten Termin herunter, sobald er in weniger als 8 Stunden beginnt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Counts down to your next event on the Lock Screen and in the Dynamic Island, once it's within 8 hours of starting."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche un compte à rebours jusqu'à votre prochain événement sur l'écran verrouillé et dans la Dynamic Island, dès qu'il commence dans moins de 8 heures."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra il conto alla rovescia per il prossimo evento nella schermata di blocco e nella Dynamic Island, quando mancano meno di 8 ore all'inizio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次の予定の開始まで8時間以内になると、ロック画面とDynamic Islandでカウントダウンします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 이벤트 시작 8시간 이내가 되면 잠금 화면과 Dynamic Island에서 카운트다운합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Telt af naar je volgende activiteit op het toegangsscherm en in het Dynamic Island, zodra die binnen 8 uur begint."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đếm ngược đến sự kiện tiếp theo trên Màn hình khóa và Dynamic Island khi còn dưới 8 giờ là bắt đầu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在下一个日程开始前 8 小时内，于锁定屏幕和灵动岛上显示倒计时。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在下一個行程開始前 8 小時內，於鎖定畫面和動態島上顯示倒數計時。"
          }
        }
      }
    },
    "StartCountdownIntent.NoEvent": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In den nächsten 8 Stunden beginnt kein Termin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No event starts in the next 8 hours."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun événement ne commence dans les 8 prochaines heures."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun evento inizia nelle prossime 8 ore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今後8時間以内に始まる予定はありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앞으로 8시간 이내에 시작하는 이벤트가 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er begint geen activiteit in de komende 8 uur."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có sự kiện nào bắt đầu trong 8 giờ tới."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接下来 8 小时内没有日程开始。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "接下來 8 小時內沒有行程開始。"
          }
        }
      }
    },
    "StartCountdownIntent.Started %@": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Countdown bis „%@“ läuft."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Counting down to %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Compte à rebours jusqu'à « %@ »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conto alla rovescia per «%@» avviato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」までカウントダウンしています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@'까지 카운트다운 중입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aftellen naar ‘%@’."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang đếm ngược đến “%@”."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在倒计时至“%@”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在倒數至「%@」。"
          }
        }
      }
    },
