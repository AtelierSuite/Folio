    "TodayAgendaIntent.Description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sagt dir, was heute in deinem Kalender steht, mit den heute fälligen Erinnerungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tells you what's on your calendar today, with the reminders due today."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous indique ce qui figure dans votre calendrier aujourd’hui, avec les rappels du jour."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ti dice cosa c’è oggi nel calendario, con i promemoria in scadenza oggi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日のカレンダーの予定と、今日が期限のリマインダーをお知らせします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오늘 캘린더 일정과 오늘 마감인 미리 알림을 알려 줍니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vertelt je wat er vandaag in je agenda staat, met de herinneringen die vandaag vervallen."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cho bạn biết lịch hôm nay, kèm các lời nhắc đến hạn hôm nay."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "告诉你今天日历上的安排，以及今天到期的提醒事项。"
