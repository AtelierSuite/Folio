    "EditNoteIntent.Description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benennt eine Notiz um oder ersetzt ihren Text. Verknüpfungen mit Ereignissen und Tagen bleiben erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renames a note or replaces its text. Links to events and days are kept."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renomme une note ou remplace son texte. Les liens vers les évènements et les jours sont conservés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rinomina una nota o ne sostituisce il testo. I collegamenti a eventi e giorni vengono mantenuti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メモの名前を変更するか本文を置き換えます。イベントや日付とのリンクは保持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메모 이름을 바꾸거나 본문을 교체합니다. 이벤트 및 날짜와의 연결은 유지됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
