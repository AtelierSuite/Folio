{
  "sourceLanguage": "en",
  "strings": {
    "Empty": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Kalender oder Listen. Erlaube Folio den Zugriff auf deine Kalender und Erinnerungen, um auszuwählen, welche angezeigt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No calendars or lists yet. Allow Folio to access your calendars and reminders to choose which ones to show."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun calendrier ni aucune liste pour l’instant. Autorisez Folio à accéder à vos calendriers et rappels pour choisir ceux à afficher."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun calendario o elenco. Consenti a Folio di accedere ai calendari e ai promemoria per scegliere quali mostrare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カレンダーとリストはまだありません。表示するものを選ぶには、Folioにカレンダーとリマインダーへのアクセスを許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 캘린더나 목록이 없습니다. 표시할 항목을 선택하려면 Folio가 캘린더와 미리 알림에 접근하도록 허용하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog geen agenda's of lijsten. Geef Folio toegang tot je agenda's en herinneringen om te kiezen welke worden getoond."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có lịch hoặc danh sách nào. Cho phép Folio truy cập lịch và lời nhắc để chọn mục cần hiển thị."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚无日历或列表。允许 Folio 访问你的日历和提醒事项，即可选择要显示的项目。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚無行事曆或列表。允許 Folio 取用你的行事曆和提醒事項，即可選擇要顯示的項目。"
          }
        }
      }
    },
