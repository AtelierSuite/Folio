    "Defaults.Footer": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neue Termine und Erinnerungen landen hier, sofern du keinen anderen Kalender oder keine andere Liste auswählst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New events and reminders go here unless you pick another calendar or list."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les nouveaux événements et rappels sont ajoutés ici, sauf si vous choisissez un autre calendrier ou une autre liste."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I nuovi eventi e promemoria vengono aggiunti qui, a meno che tu non scelga un altro calendario o elenco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のカレンダーやリストを選ばない限り、新しいイベントとリマインダーはここに追加されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 캘린더나 목록을 선택하지 않으면 새로운 이벤트와 미리 알림이 여기에 추가됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nieuwe activiteiten en herinneringen komen hier terecht, tenzij je een andere agenda of lijst kiest."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sự kiện và lời nhắc mới sẽ được thêm vào đây, trừ khi bạn chọn lịch hoặc danh sách khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "除非你选择其他日历或列表，新的日程和提醒事项都会添加到这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "除非你選擇其他行事曆或列表，新的行程和提醒事項都會加入這裡。"
          }
        }
      }
    },
