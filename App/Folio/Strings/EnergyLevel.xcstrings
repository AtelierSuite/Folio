{
  "sourceLanguage": "en",
  "strings": {
    "Settings.BleedsUnderEvents": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verlauf unter Terminen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gradient Under Events"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dégradé sous les événements"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sfumatura sotto gli eventi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予定の下にグラデーションを表示"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일정 아래에 그라데이션 표시"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verloop onder afspraken"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dải màu dưới sự kiện"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在日程下方显示渐变"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在行程下方顯示漸層"
          }
        }
      }
    },
    "Settings.Footer": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Energielevel schätzt anhand deines Schlafs in der Health-App, wann du voraussichtlich am wachsten bist. Nimm es als groben Anhaltspunkt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Energy Level estimates when you’re likely to be at your sharpest, based on your sleep in the Health app. Treat it as a rough guide."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le niveau d’énergie estime les moments où vous serez probablement le plus alerte, à partir de votre sommeil dans l’app Santé. Considérez-le comme un repère approximatif."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il livello di energia stima quando sarai probabilmente più lucido, in base al sonno registrato in Salute. Consideralo un riferimento approssimativo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エネルギーレベルは、ヘルスケアの睡眠データをもとに、集中しやすい時間帯を推定します。目安としてご利用ください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에너지 레벨은 건강 앱의 수면 데이터를 바탕으로 가장 집중하기 좋은 시간대를 추정합니다. 대략적인 참고용으로 활용하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het energieniveau schat op basis van je slaap in de Gezondheid-app wanneer je waarschijnlijk het scherpst bent. Zie het als een ruwe richtlijn."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mức năng lượng ước tính thời điểm bạn có khả năng tỉnh táo nhất, dựa trên giấc ngủ trong ứng dụng Sức khỏe. Hãy xem như một gợi ý tương đối."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "精力程度会根据健康 App 中的睡眠数据，估算你最可能精力充沛的时段。请作为大致参考。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "精力程度會根據健康 App 中的睡眠資料，估算你最可能精神最好的時段。請當作大致參考。"
          }
        }
      }
    },
    "Settings.ShowOnCalendar": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Energielevel im Kalender anzeigen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show Energy Level on Calendar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher le niveau d’énergie dans le calendrier"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra il livello di energia nel calendario"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カレンダーにエネルギーレベルを表示"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캘린더에 에너지 레벨 표시"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Energieniveau in agenda tonen"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiển thị mức năng lượng trên lịch"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在日历上显示精力程度"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在行事曆上顯示精力程度"
          }
        }
      }
    }
  },
  "version": "1.0"
}
