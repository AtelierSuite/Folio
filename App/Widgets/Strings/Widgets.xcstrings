    "DayShift.Description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändert sich im Tagesverlauf: dein Morgen, was als Nächstes kommt, dann morgen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changes through the day: your morning, what's next, then tomorrow."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Évolue au fil de la journée : votre matinée, la suite, puis demain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia durante il giorno: la mattina, ciò che viene dopo e poi domani."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "朝の予定、次の予定、夜には明日の予定と、一日の流れに合わせて表示が変わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아침 일정, 다음 일정, 저녁에는 내일 일정으로 하루에 맞춰 바뀝니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verandert door de dag: je ochtend, wat er nu komt en daarna morgen."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thay đổi theo ngày: buổi sáng, việc tiếp theo, rồi đến ngày mai."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "随一天变化：早晨安排、接下来的日程，晚上显示明天。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "隨一天變化：早晨安排、接下來的行程，晚上顯示明天。"
          }
        }
      }
    },
