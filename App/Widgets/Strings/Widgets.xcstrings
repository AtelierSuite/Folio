    "Configuration.Calendars.Description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt Termine aus den gewählten Kalendern oder aus allen sichtbaren Kalendern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows events from the calendars you choose, or all visible calendars."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche les évènements des calendriers choisis, ou de tous les calendriers visibles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra gli eventi dei calendari scelti o di tutti i calendari visibili."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選んだカレンダー、またはすべての表示中のカレンダーのイベントを表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 캘린더 또는 표시 중인 모든 캘린더의 이벤트를 보여줍니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toont activiteiten uit de gekozen agenda's of uit alle zichtbare agenda's."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiển thị sự kiện từ các lịch bạn chọn hoặc tất cả lịch đang hiển thị."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示所选日历或所有可见日历中的日程。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示所選行事曆或所有可見行事曆中的行程。"
          }
        }
      }
    },
