    "Inbox.Description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was ansteht: Einnahmen, überfällige Erinnerungen, Einladungen und Terminkonflikte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What needs you: doses, overdue reminders, invitations and clashing events."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce qui vous attend : prises, rappels en retard, invitations et conflits d’événements."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciò che richiede la tua attenzione: dosi, promemoria scaduti, inviti ed eventi sovrapposti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "服薬、期限切れのリマインダー、出欠の返事、重なっている予定など、対応が必要なことを表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복용할 약, 기한이 지난 미리 알림, 초대, 겹치는 일정 등 처리할 일을 표시합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat je aandacht nodig heeft: doses, verlopen herinneringen, uitnodigingen en overlappende afspraken."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Những việc cần bạn xử lý: liều thuốc, lời nhắc quá hạn, lời mời và sự kiện trùng lịch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要你处理的事项：用药、逾期提醒、邀请和冲突的日程。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要你處理的事項：用藥、逾期提醒、邀請和衝突的行程。"
          }
        }
      }
    },
