    "Hourly.Description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieh dir die nächsten Stunden und Ereignisse auf einen Blick an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See your upcoming hours and events at a glance."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Consultez d'un coup d'œil vos prochaines heures et événements."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla a colpo d'occhio le prossime ore e i tuoi eventi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これからの数時間の予定をひと目で確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앞으로 몇 시간의 일정을 한눈에 확인합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekijk je komende uren en activiteiten in één oogopslag."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xem nhanh các giờ sắp tới và sự kiện của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一目了然地查看接下来几小时的日程。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一目了然地查看接下來幾小時的行程。"
          }
        }
      }
    },
