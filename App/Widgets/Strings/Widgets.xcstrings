{
  "sourceLanguage": "en",
  "strings": {
    "Access.Calendars": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Widget zeigt deine Kalender, sobald Folio sie lesen darf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This widget shows your calendars once Folio can read them."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce widget affiche vos calendriers dès que Folio peut les lire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo widget mostra i tuoi calendari quando Folio potrà leggerli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Folioがカレンダーを読み取れるようになると、このウィジェットに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio가 캘린더를 읽을 수 있게 되면 이 위젯에 표시됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze widget toont je agenda's zodra Folio ze mag lezen."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiện ích này sẽ hiển thị lịch của bạn khi Folio có thể đọc chúng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio 可以读取日历后，此小组件将显示你的日历。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio 可以讀取行事曆後，此小工具將顯示你的行事曆。"
          }
        }
      }
    },
    "Access.Reminders": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Widget zeigt deine Erinnerungen, sobald Folio sie lesen darf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This widget shows your reminders once Folio can read them."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce widget affiche vos rappels dès que Folio peut les lire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo widget mostra i tuoi promemoria quando Folio potrà leggerli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Folioがリマインダーを読み取れるようになると、このウィジェットに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio가 미리 알림을 읽을 수 있게 되면 이 위젯에 표시됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze widget toont je herinneringen zodra Folio ze mag lezen."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiện ích này sẽ hiển thị lời nhắc của bạn khi Folio có thể đọc chúng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio 可以读取提醒事项后，此小组件将显示你的提醒事项。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio 可以讀取提醒事項後，此小工具將顯示你的提醒事項。"
          }
        }
      }
    },
    "Access.Title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne Folio, um den Zugriff zu erlauben"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Folio to allow access"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez Folio pour autoriser l'accès"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri Folio per consentire l'accesso"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Folioを開いてアクセスを許可してください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio를 열어 접근을 허용하세요"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Folio om toegang toe te staan"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở Folio để cho phép truy cập"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 Folio 以允许访问"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打開 Folio 以允許取用"
          }
        }
      }
    },
    "Configuration.Agenda.Description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt die heutigen Termine und Erinnerungen aus den gewählten Kalendern und Listen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows today's events and reminders from the calendars and lists you choose."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche les évènements et rappels du jour des calendriers et listes choisis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra gli eventi e i promemoria di oggi dai calendari e dagli elenchi scelti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選んだカレンダーとリストから、今日のイベントとリマインダーを表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 캘린더와 목록에서 오늘의 이벤트와 미리 알림을 보여줍니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toont de activiteiten en herinneringen van vandaag uit de gekozen agenda's en lijsten."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiển thị sự kiện và lời nhắc hôm nay từ các lịch và danh sách bạn chọn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示所选日历和列表中今天的日程和提醒事项。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示所選行事曆和列表中今天的行程和提醒事項。"
          }
        }
      }
    },
    "Configuration.Agenda.Title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
