    "LeaveBy.Setup": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere „Aufbruchszeit“ in den Datenschutzeinstellungen von Folio und erlaube den Standort „Immer“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on Leave By in Folio's Privacy settings and allow location access Always."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez Heure de départ dans les réglages Confidentialité de Folio et autorisez la position Toujours."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva Ora di partenza nelle impostazioni Privacy di Folio e consenti la posizione Sempre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Folioの「プライバシー」設定で「出発時間」をオンにして、位置情報へのアクセスを「常に」にしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Folio의 개인정보 보호 설정에서 출발 시간을 켜고 위치 접근을 '항상'으로 허용하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet Vertrektijd aan bij Privacy in Folio en sta locatietoegang Altijd toe."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật Giờ khởi hành trong cài đặt Quyền riêng tư của Folio và cho phép vị trí Luôn luôn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在 Folio 的“隐私”设置中打开“出发时间”，并将位置访问设为“始终”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在 Folio 的「隱私權」設定中開啟「出發時間」，並將位置取用權設為「永遠」。"
          }
        }
      }
    },
