            "state": "translated",
            "value": "カレンダーとリストを選択"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캘린더 및 목록 선택"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies agenda's en lijsten"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn lịch và danh sách"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择日历和列表"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇行事曆和列表"
          }
        }
      }
    },
