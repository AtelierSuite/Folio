    "LeaveBy.Description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du bei einem Termin ankommst, siehst du, wann du zum nächsten aufbrechen musst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you reach an event, see when to leave for your next one."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fois arrivé à un événement, voyez quand partir pour le suivant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando arrivi a un evento, scopri quando partire per il successivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予定の場所に着くと、次の予定に向けて出発すべき時間を表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이벤트 장소에 도착하면 다음 일정을 위해 언제 출발해야 하는지 표시합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je bij een afspraak aankomt, zie je wanneer je naar de volgende moet vertrekken."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi đến một sự kiện, xem lúc nào cần đi đến sự kiện tiếp theo."
          }
        },
        "zh-Hans": {
